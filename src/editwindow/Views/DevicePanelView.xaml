<UserControl x:Class="NavigatorHMI.Views.DevicePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="260">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 连接测试（最上方）-->
        <Button Grid.Row="0" Content="连接测试" Height="30" Command="{Binding ConnectCommand}"
                HorizontalAlignment="Left" Padding="16,0" Margin="0,0,0,8" Cursor="Hand"/>

        <!-- IP + 设备类型（中间）-->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="IP:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center"
                     ToolTip="设备 IP（如 192.168.1.146）" Padding="4,2"/>
            <TextBlock Grid.Column="2" Text="类型:" VerticalAlignment="Center" Margin="10,0,6,0"/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Height="26" VerticalContentAlignment="Center"
                      DisplayMemberPath="Model" ToolTip="设备型号（device-profile 驱动）"/>
        </Grid>

        <!-- 搜索 / 闪烁（下拉右侧横排；VNC 已单独成行——M-2 用户 2026-08-30 定）-->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="网卡:" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="搜索设备用的网卡"/>
            <ComboBox Width="90" Height="26" ItemsSource="{Binding NicList}" SelectedItem="{Binding SelectedNic}"
                      VerticalContentAlignment="Center" ToolTip="选择搜索设备用的网卡"/>
            <Button Content="搜索设备" Height="26" Padding="10,0" Margin="4,0,0,0" Command="{Binding ScanCommand}" Cursor="Hand"
                    ToolTip="按所选网卡扫描局域网设备（需先选网卡）"/>
            <Button Content="设备闪烁" Height="26" Padding="10,0" Margin="4,0,0,0" Command="{Binding BlinkCommand}" Cursor="Hand"/>
        </StackPanel>

        <!-- VNC 行（M-2：VNC 组件单独一行——启停应用按钮 + 打开查看器；打开查看器仅 VNC 启用后可用）-->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <!-- VNC 单独应用按钮（用户 2026-08-30 定：非 CheckBox，点击切换启停）-->
            <Button Content="{Binding VncButtonText}" Height="26" Padding="10,0" Command="{Binding VncCommand}" Cursor="Hand"
                    ToolTip="VNC 运行时启停（点击切换，端口见配置）"/>
            <Button Content="打开 VNC 查看器" Height="26" Padding="10,0" Margin="4,0,0,0" Command="{Binding OpenViewerCommand}" Cursor="Hand"
                    ToolTip="启动 VncViewer.exe 连接当前会话设备（需 VNC 已启用）"/>
        </StackPanel>

        <!-- 发现的设备表格（设计文档 property-device §3.2：IP/型号/ID，点击行自动填入并连接；日志统一进主窗口「输出」窗口） -->
        <GroupBox Grid.Row="4" Header="发现的设备" Margin="0,0,0,8" Padding="4">
            <DataGrid ItemsSource="{Binding FoundDevices}" SelectedItem="{Binding SelectedDevice}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderBrush="LightGray" FontSize="12" RowHeight="24"
                      MinHeight="80" MaxHeight="200"
                      ToolTip="点击行 → 自动填入 IP+型号，再点「连接测试」建立会话">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="*"/>
                    <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="*"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                    <DataGridTextColumn Header="尺寸" Binding="{Binding SizeInch}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 下载区（门禁灰显）-->
        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <Button Content="下载工程" Height="30" Padding="16,0" Command="{Binding DeployCommand}" Cursor="Hand"
                    ToolTip="编译+打包+HTTP 传输（需已连接且型号支持部署）"/>
            <TextBlock Text="（需连接测试通过）" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="#999999"/>
        </StackPanel>
    </Grid>
</UserControl>
