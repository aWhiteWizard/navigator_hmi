<Window x:Class="NavigatorHMI.Views.DeviceEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="DialogTitle" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0,4,0,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="4,0"/>
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0,4,0,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" ToolTip="设备名，如 主PLC / 温度模块"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="协议:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ProtocolBox" SelectionChanged="ProtocolBox_SelectionChanged" SelectedIndex="1">
                <ComboBoxItem Content="ModbusRTU"/>
                <ComboBoxItem Content="ModbusTCP"/>
                <ComboBoxItem Content="MQTT"/>
            </ComboBox>

            <!-- 连接参数区：按协议联动显示 -->
            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0">
                <!-- ModbusRTU：串口 + 波特率 + 从站号 -->
                <StackPanel x:Name="RtuPanel" Visibility="Collapsed">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="串口:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="RtuPortBox" Text="/dev/ttyS1"/>
                        <TextBlock Grid.Column="2" Text="波特率:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="3" x:Name="RtuBaudBox" SelectedIndex="0">
                            <ComboBoxItem Content="9600"/><ComboBoxItem Content="19200"/><ComboBoxItem Content="38400"/><ComboBoxItem Content="57600"/><ComboBoxItem Content="115200"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="从站号:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="RtuSlaveBox" Text="1" ToolTip="1-247"/>
                    </Grid>
                </StackPanel>
                <!-- ModbusTCP：IP + 端口 + 从站号 -->
                <StackPanel x:Name="TcpPanel" Visibility="Collapsed">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IP:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TcpIpBox" Text="192.168.1.50"/>
                        <TextBlock Grid.Column="2" Text="端口:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="3" x:Name="TcpPortBox" Text="502"/>
                    </Grid>
                    <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="从站号:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TcpSlaveBox" Text="1" ToolTip="1-247"/>
                    </Grid>
                </StackPanel>
                <!-- MQTT：Broker + ClientId -->
                <StackPanel x:Name="MqttPanel" Visibility="Collapsed">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Broker:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="MqttBrokerBox" Text="mqtt://192.168.1.1:1883" ToolTip="mqtt://主机:端口"/>
                    </Grid>
                    <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ClientId:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="MqttClientIdBox" Text="hmi-01"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <TextBlock x:Name="ErrorBox" Foreground="Red" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Width="80" Height="30" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="30" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
