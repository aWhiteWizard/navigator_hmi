<Window x:Class="NavigatorHMI.Views.AlarmEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="报警" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="DialogTitle" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0,4,0,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="4,0"/>
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0,4,0,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" ToolTip="报警名称（工程内唯一），如 温度过高"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="关联变量:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TagBox" ToolTip="从工程变量中选择（无变量时先 create-tag）"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="报警类型:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TypeBox">
                <ComboBoxItem Content="High" ToolTip="高报：值超过阈值时触发"/>
                <ComboBoxItem Content="Low" ToolTip="低报：值低于阈值时触发"/>
                <ComboBoxItem Content="RateChange" ToolTip="变化率报警：值变化速率超过阈值时触发"/>
                <ComboBoxItem Content="Deviation" ToolTip="偏差报警：值偏离设定值超过阈值时触发"/>
            </ComboBox>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="阈值:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="ThresholdBox" ToolTip="触发阈值（High/Low 类型的比较基准值）"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="回差:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="DeadbandBox" Text="0" ToolTip="回差值：避免阈值附近抖动触发/恢复循环"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="延迟(ms):" VerticalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="DelayBox" Text="0" ToolTip="防抖动延迟：条件持续满足超过此时间才触发报警"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="严重等级:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="SeverityBox">
                <ComboBoxItem Content="Emergency" ToolTip="紧急：需立即处理，可能造成设备损坏或安全事故"/>
                <ComboBoxItem Content="Important" ToolTip="重要：需尽快处理，影响生产质量"/>
                <ComboBoxItem Content="Warning" ToolTip="警告：需关注，暂不影响生产"/>
                <ComboBoxItem Content="Info" ToolTip="提示：信息性通知"/>
            </ComboBox>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="描述:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="7" Grid.Column="1" x:Name="MessageInputBox" ToolTip="报警描述文本（设备端显示用）"/>
        </Grid>

        <TextBlock x:Name="ErrorBox" Foreground="Red" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Width="80" Height="30" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="30" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
