<Window x:Class="NavigatorHMI.Views.EventConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NavigatorHMI.ViewModels"
        xmlns:local="clr-namespace:NavigatorHMI.Views"
        Title="事件配置" Width="520" Height="480" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResize" FontSize="12">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <!-- 参数表单字段模板：TextBox / ComboBox / NumberBox -->
        <DataTemplate DataType="{x:Type vm:ParamFieldVM}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center" ToolTip="{Binding Label}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" Text="{Binding Value}" IsEditable="True"
                          Visibility="{Binding IsCombo, Converter={StaticResource BoolToVisibilityConverter}}"
                          FontSize="12" Padding="2"/>
                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsCombo, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                         FontSize="12" VerticalContentAlignment="Center" Padding="2"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 函数列表（含添加） -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontWeight="Bold" Text="函数列表（触发后按顺序执行）" Margin="0,0,0,2"/>
            <ListBox Grid.Row="1" Height="120" ItemsSource="{Binding Functions}" SelectedItem="{Binding SelectedFunction}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="2,1">
                                <TextBlock Text="{Binding TypeName}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" FontSize="10" Width="20" Height="20" Margin="4,0,0,0"
                                    Click="RemoveFunction_Click" Tag="{Binding}" ToolTip="删除此函数"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="添加函数:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ActionCombo" Width="180" Height="26" VerticalContentAlignment="Center"/>
                <Button Content="＋ 添加" Width="70" Height="26" Margin="6,0,0,0" Click="AddFunction_Click"/>
            </StackPanel>
        </Grid>

        <Separator Grid.Row="0" Margin="0,6" VerticalAlignment="Bottom"/>

        <!-- 参数区 -->
        <ScrollViewer Grid.Row="1" Margin="0,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="函数参数" FontWeight="Bold" Margin="0,0,0,4"/>
                <!-- run_command：命令下拉 + 元数据驱动表单 -->
                <StackPanel Visibility="{Binding ShowCommandParams, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="命令" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SelectedFunction.CommandNames}" Text="{Binding SelectedFunction.CommandName}"
                                  IsEditable="True" FontSize="12" Padding="2" ToolTip="Command Layer 全量命令（按类分组）"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SelectedFunction.CommandParams}" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- 普通动作参数 -->
                <StackPanel Visibility="{Binding ShowActionParams, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding SelectedFunction.ActionParams}"/>
                </StackPanel>
                <!-- 无参数提示 -->
                <TextBlock Text="此函数无参数" Foreground="Gray" FontStyle="Italic"
                           Visibility="{Binding NoParamsHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock Text="（请先在列表选择函数）" Foreground="Gray" FontStyle="Italic"
                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="取消" Width="70" Height="28" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="✔ 确定" Width="70" Height="28" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
