<Window x:Class="NavigatorHMI.Views.HelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NavigatorHMI 帮助"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="480" MinHeight="400">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="NavigatorHMI 组态软件帮助" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="工业 HMI 组态：画面编辑、控件、变量、编译下载" Foreground="Gray" FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 帮助内容（Tab 分页：快捷键 / 操作指南 / CLI 命令） -->
        <TabControl Grid.Row="1">
            <!-- ═══ 快捷键 ═══ -->
            <TabItem Header="快捷键">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBlock Text="画布编辑" FontWeight="Bold" FontSize="13" Margin="0,4,0,4"/>
                        <DataGrid x:Name="ShortcutGrid" MaxHeight="320" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  RowHeight="24" GridLinesVisibility="Horizontal" BorderThickness="0" Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="快捷键" Width="140" Binding="{Binding Shortcut}"/>
                                <DataGridTextColumn Header="功能" Width="*" Binding="{Binding Desc}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="视图/窗口" FontWeight="Bold" FontSize="13" Margin="0,8,0,4"/>
                        <TextBlock Text="CLI 控制台：↑/↓ 命令历史，Shift+Enter 换行，help 查看帮助，cls 清屏" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="页面标签：点击切换画面，✕ 关闭标签（画面不删除）" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ 操作指南 ═══ -->
            <TabItem Header="操作指南">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <TextBlock Text="1. 新建工程" FontWeight="Bold" FontSize="13" Margin="0,4,0,2"/>
                        <TextBlock Text="欢迎页「新建」→ 输入工程名 → 选择设备型号（决定屏幕尺寸）→ 创建。" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Text="2. 编辑画面" FontWeight="Bold" FontSize="13" Margin="0,8,0,2"/>
                        <TextBlock Text="左侧控件面板选择控件 → 在画布上点击放置。选中控件后可拖拽移动、拖角缩放、属性面板改属性。" TextWrapping="Wrap" Margin="0,0,0,2"/>
                        <TextBlock Text="Ctrl+A 全选，Ctrl+C/X/V 复制/剪切/粘贴，方向键微调位置（Shift=10px）。" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Text="3. 布局辅助" FontWeight="Bold" FontSize="13" Margin="0,8,0,2"/>
                        <TextBlock Text="多选控件后：工具栏「对齐」6 方向对齐；「阵列」矩形/圆形阵列（带辅助线预览，确认才落位）。" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Text="4. 变量与绑定" FontWeight="Bold" FontSize="13" Margin="0,8,0,2"/>
                        <TextBlock Text="底部 CLI 面板：create-tag 定义变量（来源 modbus:// 或 mqtt://）→ bind-tag 绑定到控件 → 运行时显示实时值。" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Text="5. 编译与下载" FontWeight="Bold" FontSize="13" Margin="0,8,0,2"/>
                        <TextBlock Text="工具栏「编译」输出 .navihmi → 连接设备后「下载」部署。" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Text="6. 页面管理" FontWeight="Bold" FontSize="13" Margin="0,8,0,2"/>
                        <TextBlock Text="项目树：右键画面可复制/剪切/粘贴/重命名/删除；右键空白粘贴画面。画布顶部标签栏切换已打开的页面。" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ CLI 命令 ═══ -->
            <TabItem Header="CLI 命令">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="CliHelpTextBlock" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="4"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="关闭" Width="80" Height="28" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
