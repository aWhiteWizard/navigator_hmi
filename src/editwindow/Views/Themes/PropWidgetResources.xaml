            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Style:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding FrameFontStyle, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Normal"/><ComboBoxItem Content="Italic"/>
                </ComboBox>
            </Grid>
</StackPanel></DataTemplate>

        <!-- ProgressBarWidget 属性 -->
        <!-- 迁移自 EditWindow.xaml 基线 第 1061-1084 行（24 行；原 key=PropProgressBar） -->
        <DataTemplate x:Key="PropProgressBar"><StackPanel>
            <ContentControl ContentTemplate="{StaticResource PropPosition}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropSize}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropName}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropBinding}" Content="{Binding}"/>
            <Separator Margin="4,2"/>
            <TextBlock Text="参数" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Min:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding ProgressMin, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown" />
                <Label Grid.Column="2" Content="Max:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="3" Text="{Binding ProgressMax, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown" />
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="FillColor:" Style="{StaticResource PropLabel}"/>
                <ctrl:ColorPickerControl Grid.Column="1" Value="{Binding ProgressFillColor, Mode=TwoWay}"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Style:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding ProgressFillStyle, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Solid"/><ComboBoxItem Content="Diagonal"/><ComboBoxItem Content="Grid"/>
                </ComboBox>
            </Grid></StackPanel></DataTemplate>
    <!-- C13 日期时间控件属性 -->
        <!-- 迁移自 EditWindow.xaml 基线 第 1085-1098 行（14 行；原 key=PropDateTime） -->
    <DataTemplate x:Key="PropDateTime"><StackPanel>
            <ContentControl ContentTemplate="{StaticResource PropPosition}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropSize}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropName}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropBinding}" Content="{Binding}"/>
            <Separator Margin="4,2"/>
            <TextBlock Text="参数" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="格式:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" Text="{Binding DateTimeFormat, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{StaticResource PropComboBox}" ToolTip="DateTime 格式（可编辑输入自定义；选中项为常用格式）">
                                        <ComboBoxItem Content="yyyy-MM-dd HH:mm:ss"/><ComboBoxItem Content="yyyy-MM-dd"/><ComboBoxItem Content="HH:mm:ss"/><ComboBoxItem Content="yyyy/MM/dd HH:mm:ss"/><ComboBoxItem Content="yyyy年MM月dd日"/><ComboBoxItem Content="HH:mm"/><ComboBoxItem Content="yyyy:MM:dd HH:mm:ss"/></ComboBox>
            </Grid>
        </StackPanel></DataTemplate>
        <!-- P-4 趋势图控件属性（2026-09-02；TrendTagA/B 下拉复用变量选项；B 行仅变量A-B 模式可见） -->
        <!-- 迁移自 EditWindow.xaml 基线 第 1099-1169 行（71 行；原 key=PropTrendView） -->
        <DataTemplate x:Key="PropTrendView"><StackPanel>
            <ContentControl ContentTemplate="{StaticResource PropPosition}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropSize}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropName}" Content="{Binding}"/>
            <Separator Margin="4,2"/>
            <TextBlock Text="趋势" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="模式:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedItem="{Binding TrendMode}" ItemsSource="{Binding TrendModeOptions}" Style="{StaticResource PropComboBox}" ToolTip="时间-数据：单变量实时曲线；变量A-B：两变量 X-Y 散点（设计态固定——用户拍板）">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="时间-数据"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding}" Value="XY"><Setter Property="Text" Value="变量A-B"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="变量A:" Style="{StaticResource PropLabel}"/>
                <!-- 🔴 修复（审查 2026-09-02）：ItemsSource=Tag 对象集合 + VM 属性 string → 必须 SelectedValue+SelectedValuePath="Name"
                     （wpf-combobox-style §2 同款：SelectedItem 绑对象经 ToString 装载空白/回写损坏） -->
                <ComboBox Grid.Column="1" SelectedValue="{Binding TrendTagA}" SelectedValuePath="Name" ItemsSource="{Binding TrendTagAOptions}" Style="{StaticResource PropComboBox}" ToolTip="趋势变量 A（时间-数据主变量 / 变量A-B X 轴；选「（无绑定）」解除）">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Name}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Name}" Value=""><Setter Property="Text" Value="（无绑定）"/><Setter Property="Foreground" Value="#777777"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style></TextBlock></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Grid Visibility="{Binding IsXyMode, Converter={StaticResource BoolToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="变量B:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding TrendTagB}" SelectedValuePath="Name" ItemsSource="{Binding TrendTagBOptions}" Style="{StaticResource PropComboBox}" ToolTip="趋势变量 B（变量A-B 模式 Y 轴）">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Name}"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Name}" Value=""><Setter Property="Text" Value="（无绑定）"/><Setter Property="Foreground" Value="#777777"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style></TextBlock></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Separator Margin="4,2"/>
            <TextBlock Text="采样与时间窗" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="采样间隔:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding SampleIntervalMs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropTextBox}" ToolTip="采样间隔（毫秒，100~60000，默认 1000）" KeyDown="PropField_KeyDown"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="时间窗:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding TimeWindowSeconds, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropTextBox}" ToolTip="显示时间窗（秒，5~3600，默认 60）" KeyDown="PropField_KeyDown"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="刷新率:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding RefreshRateMs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropTextBox}" ToolTip="曲线刷新率（毫秒，50~10000，默认 500）" KeyDown="PropField_KeyDown"/>
            </Grid>
            <Separator Margin="4,2"/>
            <TextBlock Text="曲线样式" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="颜色:" Style="{StaticResource PropLabel}"/>
                <ctrl:ColorPickerControl Grid.Column="1" Value="{Binding LineColor, Mode=TwoWay}" ToolTip="曲线颜色"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="线宽:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding LineWidth, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropTextBox}" ToolTip="曲线粗细（像素）" KeyDown="PropField_KeyDown"/>
            </Grid>
        </StackPanel></DataTemplate>
        <!-- P-5 历史记录控件属性（2026-09-02：变量列表多变量逗号分隔 + 数据库路径） -->
        <!-- 迁移自 EditWindow.xaml 基线 第 1170-1197 行（28 行；原 key=PropHistoryView） -->
        <DataTemplate x:Key="PropHistoryView"><StackPanel>
            <ContentControl ContentTemplate="{StaticResource PropPosition}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropSize}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropName}" Content="{Binding}"/>
            <Separator Margin="4,2"/>
            <TextBlock Text="历史" Style="{StaticResource PropGroupHeader}"/>
            <!-- Q-6（2026-09-04 用户 Check）：变量配置表格化——每行：变量下拉 + Title 列显示名 + 删行；下加「添加变量」 -->
            <ItemsControl ItemsSource="{Binding HistoryTagRows}" Margin="4,2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding DataContext.HistoryTagOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      DisplayMemberPath="Name" SelectedValue="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Name"
                                      FontSize="10" Height="20" ToolTip="选择变量（历史记录变量列表）"/>
                            <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=LostFocus}" Margin="2,0" FontSize="10" Height="20"
                                     ToolTip="列显示名（空 = 显示变量名本身）"/>
                            <Button Grid.Column="2" Content="✕" FontSize="9" Width="20" Height="18" Click="RemoveHistoryTagRow_Click" ToolTip="删除此行"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="＋ 添加变量" Click="AddHistoryTagRow_Click" Margin="4,2" HorizontalAlignment="Left" Padding="8,2" FontSize="10"/>
            <Grid Margin="4,2"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="数据库:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding HistoryDbPath, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropTextBox}" ToolTip="历史数据库路径（空=设备端默认 navihmi_history.db）" KeyDown="PropField_KeyDown"/>
            </Grid>
        </StackPanel></DataTemplate>
</ResourceDictionary>
