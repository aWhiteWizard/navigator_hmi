<Window x:Class="NavigatorHMI.Views.TagEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="变量" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="DialogTitle" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <!-- AH（2026-10-30）：换算三行（换算系数 / 偏移 / 小数位） -->
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0,4,0,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="4,0"/>
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0,4,0,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" ToolTip="工程内唯一，如 Tank1_Temp"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="数据类型:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DataTypeBox" SelectionChanged="DataTypeBox_SelectionChanged">
                <ComboBoxItem Content="BOOL"/>
                <ComboBoxItem Content="INT16"/>
                <ComboBoxItem Content="UINT16"/>
                <ComboBoxItem Content="INT32"/>
                <ComboBoxItem Content="FLOAT"/>
                <ComboBoxItem Content="STRING"/>
                <ComboBoxItem Content="DATETIME"/>
                <ComboBoxItem Content="GPS"/>
            </ComboBox>

            <!-- 来源：下拉选择「内部变量」或通讯设备；选中设备后填写地址/主题 -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="来源:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="SourceBox" SelectionChanged="SourceBox_SelectionChanged"
                      ToolTip="内部变量（无外部来源）或通讯设备（Modbus 寄存器 / MQTT 主题）"/>

            <TextBlock Grid.Row="3" Grid.Column="0" x:Name="AddressLabel" Text="地址:" VerticalAlignment="Center" Visibility="Collapsed"/>
            <!-- 2026-09-16：地址输入实时换算提示（裸数字 / 4x 记法 / 40002 式 / 完整 modbus://串 均可，统一归一化） -->
            <StackPanel Grid.Row="3" Grid.Column="1" x:Name="AddressPanel" Visibility="Collapsed">
                <TextBox x:Name="AddressBox" TextChanged="AddressBox_TextChanged"
                         ToolTip="寄存器地址（三种等价写法）：裸数字 = PDU 地址（如 1）；4x 记法 = 保持寄存器编号（如 4x:0002）；PLC 式（如 40002）。也可直接粘贴完整 modbus://100/1"/>
                <TextBlock x:Name="AddressHint" FontSize="10" Foreground="DarkSlateGray" Margin="0,2,0,0" TextWrapping="Wrap" IsHitTestVisible="False"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"><Run Text="单位:"/><Run Text="（可选）" Foreground="Gray" FontSize="10"/></TextBlock>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="UnitBox" ToolTip="如 °C / rpm / m（可留空）"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="采集周期:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="ScanIntervalBox" SelectedIndex="0">
                <ComboBoxItem Content="100 毫秒" Tag="100"/>
                <ComboBoxItem Content="200 毫秒" Tag="200"/>
                <ComboBoxItem Content="500 毫秒" Tag="500"/>
                <ComboBoxItem Content="1 秒" Tag="1000"/>
                <ComboBoxItem Content="2 秒" Tag="2000"/>
                <ComboBoxItem Content="5 秒" Tag="5000"/>
                <ComboBoxItem Content="10 秒" Tag="10000"/>
            </ComboBox>

            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"><Run Text="死区:"/><Run Text="（可选）" Foreground="Gray" FontSize="10"/></TextBlock>
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="DeadbandBox" Text="0" ToolTip="变化小于此值不触发刷新（默认 0 = 不启用）"/>

            <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"><Run Text="描述:"/><Run Text="（可选）" Foreground="Gray" FontSize="10"/></TextBlock>
            <TextBox Grid.Row="7" Grid.Column="1" x:Name="DescriptionBox" ToolTip="用户备注（不参与运行时逻辑）"/>

            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"><Run Text="基准值:"/><Run Text="（可选）" Foreground="Gray" FontSize="10"/></TextBlock>
            <Grid Grid.Row="8" Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <!-- BOOL 与数字共用 * 列（Visibility 互斥切换，BoolBaseBox 占满列宽与其他输入框一致） -->
                <TextBox Grid.Column="0" Grid.ColumnSpan="2" x:Name="BaseValueBox" ToolTip="设计态预览值：数字变量填数字，图片变量填路径（BOOL 类型请用下拉选择）"/>
                <ComboBox Grid.Column="0" Grid.ColumnSpan="2" x:Name="BoolBaseBox" Visibility="Collapsed" SelectedIndex="0">
                    <ComboBoxItem Content="false"/><ComboBoxItem Content="true"/>
                </ComboBox>
                <!-- V-5a：GPS 类型基准值拆两框（续23 方案 B：小数度输入，正=E/N 负=W/S）+ DMS 实时换算提示（仅输入状态显示） -->
                <TextBox Grid.Row="0" Grid.Column="0" x:Name="LngBaseBox" Visibility="Collapsed" Margin="0,0,2,0"
                         ToolTip="经度（东经为正，负号=西经），如 104.06" TextChanged="GpsBaseBox_TextChanged" LostFocus="GpsBaseBox_LostFocus"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="LatBaseBox" Visibility="Collapsed" Margin="2,0,0,0"
                         ToolTip="纬度（北纬为正，负号=南纬），如 30.67" TextChanged="GpsBaseBox_TextChanged" LostFocus="GpsBaseBox_LostFocus"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="GpsDmsHint" Foreground="DarkSlateGray" FontSize="10" Margin="0,2,0,0" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>

            <!-- AH（2026-10-30 用户需求）：数据换算——工程值 = 原始值 × 系数 + 偏移；小数位 N 会自动把系数设为 10^-N -->
            <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" ToolTip="工程值 = 寄存器原始值 × 系数 + 偏移&#10;例：寄存器 206 表示 20.6℃ ⇒ 系数 0.1">
                <Run Text="换算系数:"/><Run Text="（可选）" Foreground="Gray" FontSize="10"/></TextBlock>
            <TextBox Grid.Row="9" Grid.Column="1" x:Name="ScaleBox" Text="1"
                     ToolTip="工程值 = 原始值 × 系数 + 偏移（默认 1 = 不换算）。例：寄存器 206 表示 20.6℃ ⇒ 填 0.1"/>

            <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center"><Run Text="偏移:"/><Run Text="（可选）" Foreground="Gray" FontSize="10"/></TextBlock>
            <TextBox Grid.Row="10" Grid.Column="1" x:Name="OffsetBox" Text="0"
                     ToolTip="换算后加的常数（默认 0）。用于零点校正：工程值 = 原始值 × 系数 + 偏移"/>

            <TextBlock Grid.Row="11" Grid.Column="0" VerticalAlignment="Center"><Run Text="小数位:"/><Run Text="（可选）" Foreground="Gray" FontSize="10"/></TextBlock>
            <Grid Grid.Row="11" Grid.Column="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="DecimalsBox" Text="0" ToolTip="0 = 不限制；N 会自动把换算系数设为 10^-N（需求文档常写的「小数位 1」就填 1 → 系数 0.1）"/>
                <TextBlock Grid.Column="1" x:Name="DecimalsHint" Foreground="DarkSlateGray" FontSize="10" Margin="6,0,0,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"/>
            </Grid>
        </Grid>

        <TextBlock x:Name="ErrorBox" Foreground="Red" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Width="80" Height="30" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="30" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
