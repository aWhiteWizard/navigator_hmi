<Window x:Class="NavigatorHMI.Views.TagEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="变量" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="DialogTitle" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0,4,0,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="4,0"/>
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="Height" Value="26"/><Setter Property="Margin" Value="0,4,0,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" ToolTip="工程内唯一，如 Tank1_Temp"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="数据类型:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DataTypeBox" SelectedIndex="4">
                <ComboBoxItem Content="BOOL"/>
                <ComboBoxItem Content="INT16"/>
                <ComboBoxItem Content="UINT16"/>
                <ComboBoxItem Content="INT32"/>
                <ComboBoxItem Content="FLOAT"/>
                <ComboBoxItem Content="STRING"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="来源:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="SourceBox"
                     ToolTip="modbus://1/40001 或 mqtt://robot/pose/x"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="单位:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="UnitBox" ToolTip="如 °C / rpm / m（可留空）"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="采集周期(ms):" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="ScanIntervalBox" Text="100" ToolTip="默认 100ms"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="死区:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="DeadbandBox" Text="0" ToolTip="变化小于此值不触发刷新"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="描述:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="DescriptionBox"/>
        </Grid>

        <TextBlock x:Name="ErrorBox" Foreground="Red" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Width="80" Height="30" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="30" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
