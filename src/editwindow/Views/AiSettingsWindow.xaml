<Window x:Class="NavigatorHMI.Views.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 助手设置" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#FAFAFA">
    <StackPanel Margin="18,14">
        <TextBlock Text="API Key" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
        <TextBlock Text="用于云端模型（DeepSeek Chat / Reasoner）。留空则使用环境变量 NAVIGATOR_HMI_AI_KEY 或 DEEPSEEK_API。"
                   TextWrapping="Wrap" Foreground="#666666" FontSize="11" Margin="0,0,0,6"/>
        <PasswordBox x:Name="ApiKeyBox" Height="28" FontSize="13" Padding="4,2"
                     ToolTip="输入新的 API Key（保存后替换旧值）；留空并点保存 = 清除已保存的 Key"/>
        <TextBlock x:Name="HasKeyHint" Text="（当前未配置，将使用环境变量）" Foreground="#2D7DD2" FontSize="11" Margin="0,6,0,0"/>
        <TextBlock Text="保存后使用 Windows DPAPI 加密存储（仅本机当前用户可解密），配置文件位于 %APPDATA%\NavigatorHMI\ai-config.json，不随工程分发。"
                   TextWrapping="Wrap" Foreground="#999999" FontSize="10" Margin="0,8,0,0"/>
        <TextBlock Text="本地模型路径（GGUF）" FontWeight="Bold" FontSize="13" Margin="0,16,0,4"/>
        <TextBlock Text="本地 Qwen 模型文件路径；留空自动查找仓库 models/ 目录。" TextWrapping="Wrap" Foreground="#666666" FontSize="11" Margin="0,0,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ModelPathBox" Height="28" FontSize="12" Padding="4,2" VerticalContentAlignment="Center"
                     ToolTip="本地 GGUF 文件路径（如 D:\models\qwen2.5-7b-instruct-q4_k_m.gguf）"/>
            <Button Grid.Column="1" Content="浏览…" Height="28" Margin="6,0,0,0" Padding="10,0" Click="Browse_Click" Cursor="Hand"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="保存" Width="72" Height="28" Click="Save_Click" Background="#2D7DD2" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="取消" Width="72" Height="28" Margin="8,0,0,0" Click="Cancel_Click" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
