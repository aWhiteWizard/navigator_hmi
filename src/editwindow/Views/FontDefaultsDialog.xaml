<Window x:Class="NavigatorHMI.Views.FontDefaultsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="默认字体设置" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Background="White" Width="360">
    <Window.Resources>
        <!-- 系统字体列表（字体下拉选择）-->
        <ObjectDataProvider x:Key="SystemFonts" ObjectType="{x:Type Fonts}" MethodName="get_SystemFontFamilies"/>
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock Text="工厂默认字体（影响所有新添加控件）" FontWeight="Bold" Margin="0,0,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="字体:" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" x:Name="FontFamilyBox" SelectedValuePath="Source" DisplayMemberPath="Source"
                      ItemsSource="{Binding Source={StaticResource SystemFonts}}" Height="24" Margin="2"/>
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="字号:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="FontSizeBox" Height="24" Margin="2" VerticalContentAlignment="Center"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <CheckBox x:Name="BoldBox" Content="加粗" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="ItalicBox" Content="倾斜" Margin="0,0,16,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="UnderlineBox" Content="下划线" VerticalAlignment="Center"/>
        </StackPanel>
        <Separator Margin="0,8"/>
        <TextBlock Text="预览" FontWeight="Bold" Margin="0,0,0,4"/>
        <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Background="#F5F5F5" Margin="0,0,0,10">
            <TextBlock x:Name="PreviewText" Text="示例文字 AaBb123" FontSize="18"/>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" IsDefault="True" Width="72" Height="28" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="取消" IsCancel="True" Width="72" Height="28"/>
        </StackPanel>
    </StackPanel>
</Window>
