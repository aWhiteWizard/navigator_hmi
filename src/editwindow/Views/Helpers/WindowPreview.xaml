<UserControl x:Class="NavigatorHMI.Views.Helpers.WindowPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NavigatorHMI.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    <Border BorderBrush="{Binding BorderColor}" BorderThickness="1" Background="{Binding FillColor}" CornerRadius="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- 标题栏（ShowTitleBar） -->
            <Border Grid.Row="0" Background="#2B579A" Padding="6,2">
                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11" FontWeight="Bold"
                           Visibility="{Binding ShowTitleBar, Converter={StaticResource B2V}}"/>
            </Border>
            <!-- 内容：按 WindowType 三预览 -->
            <Grid Grid.Row="1">
                <!-- UserView：未登录示例（头像占位+未登录+登录按钮） -->
                <StackPanel Visibility="{Binding IsUserView, RelativeSource={RelativeSource Self}, Converter={StaticResource B2V}}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="#C8C8C8" HorizontalAlignment="Center">
                        <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="未登录" HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="11" Foreground="#666666"/>
                    <TextBlock Text="运行模式: 手动" HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="10" Foreground="#888888"
                               Visibility="{Binding ShowMode, Converter={StaticResource B2V}}"/>
                    <Button Content="登 录" Width="70" Height="22" Margin="0,6,0,0" FontSize="10"/>
                </StackPanel>
                <!-- AlarmView：2-3 条示例报警（级别色标） -->
                <StackPanel Visibility="{Binding IsAlarmView, RelativeSource={RelativeSource Self}, Converter={StaticResource B2V}}" Margin="4">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Rectangle Width="4" Height="12" Fill="#E81123" Margin="0,0,4,0"/>
                        <TextBlock Text="12:03:05  紧急  压力超限" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Rectangle Width="4" Height="12" Fill="#F7630C" Margin="0,0,4,0"/>
                        <TextBlock Text="12:01:22  重要  温度过高" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Rectangle Width="4" Height="12" Fill="#FFB900" Margin="0,0,4,0"/>
                        <TextBlock Text="11:58:40  警告  液位偏低" FontSize="10"/>
                    </StackPanel>
                    <TextBlock Text="暂无活动报警" FontSize="10" Foreground="Gray" Margin="0,8,0,0"
                               Visibility="{Binding IsAlarmViewEmpty, RelativeSource={RelativeSource Self}, Converter={StaticResource B2V}}"/>
                </StackPanel>
                <!-- RobotList：3 张示例卡片（不同大类图标） -->
                <StackPanel Visibility="{Binding IsRobotList, RelativeSource={RelativeSource Self}, Converter={StaticResource B2V}}" Margin="4">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="70" Height="76" BorderBrush="#999" BorderThickness="1" CornerRadius="3" Margin="0,0,4,0" Background="White">
                            <StackPanel>
                                <TextBlock Text="🛸" FontSize="18" HorizontalAlignment="Center"/>
                                <Ellipse Width="6" Height="6" Fill="#107C10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="R01" FontSize="9" HorizontalAlignment="Center"/>
                                <TextBlock Text="运行" FontSize="8" HorizontalAlignment="Center" Foreground="#107C10"/>
                                <TextBlock Text="A区-3号位" FontSize="7" HorizontalAlignment="Center" Foreground="#888"/>
                            </StackPanel>
                        </Border>
                        <Border Width="70" Height="76" BorderBrush="#999" BorderThickness="1" CornerRadius="3" Margin="0,0,4,0" Background="White">
                            <StackPanel>
                                <TextBlock Text="🚙" FontSize="18" HorizontalAlignment="Center"/>
                                <Ellipse Width="6" Height="6" Fill="#888" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="R02" FontSize="9" HorizontalAlignment="Center"/>
                                <TextBlock Text="空闲" FontSize="8" HorizontalAlignment="Center" Foreground="#666"/>
                                <TextBlock Text="B区-1号位" FontSize="7" HorizontalAlignment="Center" Foreground="#888"/>
                            </StackPanel>
                        </Border>
                        <Border Width="70" Height="76" BorderBrush="#999" BorderThickness="1" CornerRadius="3" Background="White">
                            <StackPanel>
                                <TextBlock Text="🤖" FontSize="18" HorizontalAlignment="Center"/>
                                <Ellipse Width="6" Height="6" Fill="#E81123" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="R03" FontSize="9" HorizontalAlignment="Center"/>
                                <TextBlock Text="故障" FontSize="8" HorizontalAlignment="Center" Foreground="#E81123"/>
                                <TextBlock Text="A区-5号位" FontSize="7" HorizontalAlignment="Center" Foreground="#888"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="（设计态预览——运行时由绑定的 RobotSlots 变量驱动）" FontSize="8" Foreground="#999" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
