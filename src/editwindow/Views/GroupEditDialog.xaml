<Window x:Class="NavigatorHMI.Views.GroupEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户组" Width="340" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize" FontSize="12">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="组名:" VerticalAlignment="Center"/>
            <TextBox x:Name="NameBox" Grid.Column="1" Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" Padding="2" IsReadOnly="{Binding GroupNameReadOnly}">
                <TextBox.Style>
                    <!-- W-5a：预设组组名只读（灰底 + 提示），仅可改权限 -->
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GroupNameReadOnly}" Value="True">
                                <Setter Property="Background" Value="#F2F2F2"/>
                                <Setter Property="ToolTip" Value="预设组不可改名，仅可修改权限"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Grid>
        <TextBlock Grid.Row="1" Text="权限:" FontWeight="Bold" Margin="0,10,0,2"/>
        <StackPanel Grid.Row="2">
            <CheckBox Content="画面编辑（运行时切编辑模式等）" IsChecked="{Binding ScreenEdit}" Margin="0,2"/>
            <CheckBox Content="报警确认/清除" IsChecked="{Binding AlarmAck}" Margin="0,2"/>
            <CheckBox Content="用户管理（增删用户/改密码/改组）" IsChecked="{Binding UserManage}" Margin="0,2"/>
            <CheckBox Content="系统设置（时间/网络/配置）" IsChecked="{Binding SystemSettings}" Margin="0,2"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="70" Height="28" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="确定" Width="70" Height="28" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
