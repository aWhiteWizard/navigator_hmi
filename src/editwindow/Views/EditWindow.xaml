<Window x:Class="NavigatorHMI.Views.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:NavigatorHMI.Views"
        xmlns:local="clr-namespace:NavigatorHMI"
        xmlns:vm="clr-namespace:NavigatorHMI.ViewModels"
        xmlns:h="clr-namespace:NavigatorHMI.Views.Helpers"
        xmlns:avalon="https://github.com/Dirkster99/AvalonDock"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        mc:Ignorable="d"
        WindowState="Maximized"
        Closing="EditWindow_Closing"
        SizeChanged="EditWindow_SizeChanged"
        PreviewKeyDown="EditWindow_PreviewKeyDown"
        Title="NavigatorHMI" Height="450" Width="800">
    <Window.Resources>
        <!-- 系统字体列表（字体下拉选择，只读不可编辑）-->
        <!-- 注意：Fonts.SystemFontFamilies 是静态属性非方法，ODP MethodName 必须用 get_ 前缀，否则静默返回 null -->
        <ObjectDataProvider x:Key="SystemFonts" ObjectType="{x:Type Fonts}" MethodName="get_SystemFontFamilies"/>
        <DrawingBrush x:Key="DotGridBrush" TileMode="Tile" Viewport="0,0,5,5" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Geometry="M0,0 L5,0 L5,5 L0,5 Z" Brush="Gainsboro"/>
                <GeometryDrawing Geometry="M2.5,2.5 A0.5,0.5 0 1,1 2.5,2.4" Brush="Black"/>
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- 选中蓝（统一资源：画布框选 Marquee + 变量管理器行选中共用，防多处置色漂移） -->
        <SolidColorBrush x:Key="SelectionBlueBrush" Color="Blue"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <h:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <h:PathToImageSourceConverter x:Key="PathToImageConverter"/>
        <!-- AI 消息右键菜单：拖选复制选中段，未选中复制整条（AiMsgCopy_Click 判定） -->
        <ContextMenu x:Key="AiMessageContextMenu">
            <MenuItem Header="复制" Click="AiMsgCopy_Click"/>
        </ContextMenu>

        <!-- 属性面板样式 -->
        <Style x:Key="PropGroupHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2B579A"/><Setter Property="Margin" Value="4,8,4,2"/>
        </Style>
        <Style x:Key="PropLabel" TargetType="Label">
            <Setter Property="Padding" Value="2"/><Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="PropNumberBox" TargetType="TextBox">
            <Setter Property="Height" Value="22"/><Setter Property="Margin" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <!-- 数值输入过滤：仅允许数字/小数点/负号/编辑键（与 CLI 数值校验同规则） -->
            <EventSetter Event="PreviewTextInput" Handler="PropNumberBox_PreviewTextInput"/>
            <Style.Triggers><Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="#F0F0F0"/><Setter Property="Foreground" Value="#999999"/><Setter Property="BorderBrush" Value="#D0D0D0"/>
            </Trigger></Style.Triggers>
        </Style>
        <Style x:Key="PropTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="22"/><Setter Property="Margin" Value="2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="11"/>
            <Style.Triggers><Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="#F0F0F0"/><Setter Property="Foreground" Value="#999999"/><Setter Property="BorderBrush" Value="#D0D0D0"/>
            </Trigger></Style.Triggers>
        </Style>
        <Style x:Key="PropComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="22"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="PropObjNameBox" TargetType="TextBox" BasedOn="{StaticResource PropTextBox}">
            <Style.Triggers><DataTrigger Binding="{Binding HasDuplicateObjectName}" Value="True">
                <Setter Property="Background" Value="#FFE0E0"/><Setter Property="BorderBrush" Value="Red"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="PropPosition"><StackPanel>
            <TextBlock Text="位置" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="X:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding X, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown" ToolTip="输入完成后失焦确认生效"/>
                <Label Grid.Column="3" Content="Y:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="4" Text="{Binding Y, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown" ToolTip="输入完成后失焦确认生效"/>
        </Grid></StackPanel></DataTemplate>
        <DataTemplate x:Key="PropSize"><StackPanel>
            <TextBlock Text="尺寸" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="W:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding Width, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown" ToolTip="输入完成后失焦确认生效"/>
                <Label Grid.Column="3" Content="H:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="4" Text="{Binding Height, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown" ToolTip="输入完成后失焦确认生效"/>
        </Grid></StackPanel></DataTemplate>
        <DataTemplate x:Key="PropName"><StackPanel>
            <TextBlock Text="名称" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="ObjectName:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding ObjectName, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropObjNameBox}" KeyDown="PropField_KeyDown"/>
        </Grid></StackPanel></DataTemplate>

        <!-- 数据绑定：控件绑定变量（下拉选变量，哨兵项「（无绑定）」 = 解除绑定） -->
        <DataTemplate x:Key="PropBinding"><StackPanel>
            <TextBlock Text="数据绑定" Style="{StaticResource PropGroupHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="变量:" Style="{StaticResource PropLabel}"/>
                <Grid Grid.Column="1">
                <ComboBox SelectedItem="{Binding BoundTag}" ItemsSource="{Binding BindableTags}" Style="{StaticResource PropComboBox}"
                          ToolTip="绑定变量后，控件显示该变量的实时值（选「（无绑定）」解除）">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <!-- ⚠️ 不能设本地 Text（优先级高于 Style 触发器，会压制 DataTrigger 的「（无绑定）」）；属性只放 Style Setter -->
                            <TextBlock>
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Name}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Name}" Value="">
                                        <Setter Property="Text" Value="（无绑定）"/>
                                        <Setter Property="Foreground" Value="#777777"/>
                                    </DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                    <TextBlock Text="（无绑定）" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#777777" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BoundTag}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </StackPanel></DataTemplate>

        <!-- 多选批量编辑模板（框选多个控件时显示） -->
        <DataTemplate x:Key="PropMultiSelect"><StackPanel>
            <TextBlock Text="{Binding SelectedWidgets.Count, StringFormat=批量编辑 (已选 {0} 个控件)}" Style="{StaticResource PropGroupHeader}"/>
            <TextBlock Text="字体" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Font:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding BatchFontFamily, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Source" DisplayMemberPath="Source" ItemsSource="{Binding Source={StaticResource SystemFonts}}" Style="{StaticResource PropComboBox}"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Size:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding BatchFontSize, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown"/>
                <Label Grid.Column="2" Content="Bold:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding BatchFontWeight, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Normal"/><ComboBoxItem Content="Bold"/>
                </ComboBox>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Style:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding BatchFontStyle, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Normal"/><ComboBoxItem Content="Italic"/>
                </ComboBox>
                <Label Grid.Column="2" Content="Undr:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding BatchTextDecoration, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="None"/><ComboBoxItem Content="Underline"/>
                </ComboBox>
            </Grid>
            <TextBlock Text="颜色" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="文本色:" Style="{StaticResource PropLabel}"/>
                <ctrl:ColorPickerControl Grid.Column="1" Value="{Binding BatchTextColor, Mode=TwoWay}"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="背景色:" Style="{StaticResource PropLabel}"/>
                <ctrl:ColorPickerControl Grid.Column="1" Value="{Binding BatchFillColor, Mode=TwoWay}"/>
            </Grid>
        </StackPanel></DataTemplate>
        <DataTemplate x:Key="PropScreen"><StackPanel>
            <TextBlock Text="画面名称" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="名称:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding ScreenName, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsScreenNameReadOnly}" Style="{StaticResource PropTextBox}" KeyDown="PropField_KeyDown" />
            </Grid>
            <TextBlock Text="尺寸" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="W:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding ScreenWidth, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource PropNumberBox}"/>
                <Label Grid.Column="3" Content="H:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="4" Text="{Binding ScreenHeight, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource PropNumberBox}"/>
            </Grid>
            <TextBlock Text="类型" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="类型:" Style="{StaticResource PropLabel}"/>
                <TextBlock Grid.Column="1" Text="{Binding ScreenTypeText}" VerticalAlignment="Center" Margin="4,0" FontSize="11"/>
            </Grid>
            <TextBlock Text="全局叠加" Style="{StaticResource PropGroupHeader}" Visibility="{Binding IsWorldMapScreen, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Grid Visibility="{Binding IsWorldMapScreen, Converter={StaticResource BoolToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="显示全局:" Style="{StaticResource PropLabel}"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding WorldMapShowGlobalOverlay}" VerticalAlignment="Center" ToolTip="勾选后世界地图上叠加显示全局画面内容（设备端运行时同步生效）"/>
            </Grid>
        </StackPanel></DataTemplate>
        <DataTemplate x:Key="PropButton"><StackPanel>
            <ContentControl ContentTemplate="{StaticResource PropPosition}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropSize}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropName}" Content="{Binding}"/>
            <Separator Margin="4,2"/>
            <TextBlock Text="外观" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Text:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding ButtonText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropTextBox}" KeyDown="PropField_KeyDown" />
        </Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Color:" Style="{StaticResource PropLabel}"/>
                <ctrl:ColorPickerControl Grid.Column="1" Value="{Binding ButtonTextColor, Mode=TwoWay}"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="BgColor:" Style="{StaticResource PropLabel}"/>
                <ctrl:ColorPickerControl Grid.Column="1" Value="{Binding ButtonFillColor, Mode=TwoWay}"/>
            </Grid>
<TextBlock Text="字体" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Font:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding ButtonFontFamily, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Source" DisplayMemberPath="Source" ItemsSource="{Binding Source={StaticResource SystemFonts}}" Style="{StaticResource PropComboBox}"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Size:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding ButtonFontSize, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown" />
                <Label Grid.Column="2" Content="Bold:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding ButtonFontWeight, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Normal"/><ComboBoxItem Content="Bold"/>
                </ComboBox>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Style:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding ButtonFontStyle, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Normal"/><ComboBoxItem Content="Italic"/>
                </ComboBox>
                <Label Grid.Column="2" Content="Undr:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding ButtonTextDecoration, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="None"/><ComboBoxItem Content="Underline"/>
                </ComboBox>
            </Grid>
</StackPanel></DataTemplate>
        <DataTemplate x:Key="PropText"><StackPanel>
            <ContentControl ContentTemplate="{StaticResource PropPosition}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropSize}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropName}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropBinding}" Content="{Binding}"/>
            <Separator Margin="4,2"/>
            <TextBlock Text="外观" Style="{StaticResource PropGroupHeader}"/>
            <Grid Visibility="{Binding IsValueEditable, Converter={StaticResource BoolToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Content:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding TextContent, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropTextBox}" ToolTip="静态文本（绑定变量后由变量值覆盖，隐藏）" KeyDown="PropField_KeyDown" />
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Color:" Style="{StaticResource PropLabel}"/>
                <ctrl:ColorPickerControl Grid.Column="1" Value="{Binding TextFillColor, Mode=TwoWay}"/>
            </Grid>
            <TextBlock Text="字体" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Size:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding TextFontSize, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown" />
                <Label Grid.Column="2" Content="Weight:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding TextFontWeight, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Normal"/><ComboBoxItem Content="Bold"/>
                </ComboBox>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Color:" Style="{StaticResource PropLabel}"/>
                <ctrl:ColorPickerControl Grid.Column="1" Value="{Binding TextTextColor, Mode=TwoWay}"/>
                <Label Grid.Column="2" Content="Align:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding TextHAlign, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Left"/><ComboBoxItem Content="Center"/><ComboBoxItem Content="Right"/>
                </ComboBox>
            </Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Font:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding TextFontFamily, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Source" DisplayMemberPath="Source" ItemsSource="{Binding Source={StaticResource SystemFonts}}" Style="{StaticResource PropComboBox}"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Style:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding TextFontStyle, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Normal"/><ComboBoxItem Content="Italic"/>
                </ComboBox>
                <Label Grid.Column="2" Content="Undr:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding TextTextDecoration, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="None"/><ComboBoxItem Content="Underline"/>
                </ComboBox>
            </Grid>
</StackPanel></DataTemplate>
        <DataTemplate x:Key="PropRect"><StackPanel>
            <ContentControl ContentTemplate="{StaticResource PropPosition}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropSize}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropName}" Content="{Binding}"/>
            <Separator Margin="4,2"/>
            <TextBlock Text="外观" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="FillColor:" Style="{StaticResource PropLabel}"/>
                <ctrl:ColorPickerControl Grid.Column="1" Value="{Binding RectFillColor, Mode=TwoWay}"/>
        </Grid></StackPanel></DataTemplate>

        <!-- LabelWidget 属性 -->
        <DataTemplate x:Key="PropLabelWidget"><StackPanel>
            <ContentControl ContentTemplate="{StaticResource PropPosition}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropSize}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropName}" Content="{Binding}"/>
            <Separator Margin="4,2"/>
            <TextBlock Text="外观" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Text:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding LabelText, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropTextBox}" KeyDown="PropField_KeyDown" />
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="FontSize:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding LabelFontSize, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown" />
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Color:" Style="{StaticResource PropLabel}"/>
                <ctrl:ColorPickerControl Grid.Column="1" Value="{Binding LabelTextColor, Mode=TwoWay}"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="BgColor:" Style="{StaticResource PropLabel}"/>
                <ctrl:ColorPickerControl Grid.Column="1" Value="{Binding LabelFillColor, Mode=TwoWay}"/>
            </Grid><TextBlock Text="字体" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Font:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding LabelFontFamily, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Source" DisplayMemberPath="Source" ItemsSource="{Binding Source={StaticResource SystemFonts}}" Style="{StaticResource PropComboBox}"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Size:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding LabelFontSize, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown" />
                <Label Grid.Column="2" Content="Bold:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding LabelFontWeight, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Normal"/><ComboBoxItem Content="Bold"/>
                </ComboBox>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Style:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding LabelFontStyle, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Normal"/><ComboBoxItem Content="Italic"/>
                </ComboBox>
                <Label Grid.Column="2" Content="Undr:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding LabelTextDecoration, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="None"/><ComboBoxItem Content="Underline"/>
                </ComboBox>
            </Grid>
</StackPanel></DataTemplate>

        <!-- ImageWidget 属性 -->
        <DataTemplate x:Key="PropImage"><StackPanel>
            <ContentControl ContentTemplate="{StaticResource PropPosition}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropSize}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropName}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropBinding}" Content="{Binding}"/>
            <Separator Margin="4,2"/>
            <TextBlock Text="图片列表" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="列表:" Style="{StaticResource PropLabel}"/>
                <Grid Grid.Column="1">
                <ComboBox SelectedItem="{Binding ImageListRef}" ItemsSource="{Binding ImageListOptions}" Style="{StaticResource PropComboBox}" ToolTip="选择图片列表（选「（无绑定）」解除，显示自身路径静态图）">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
