    <Window.CommandBindings><CommandBinding Command="Save" Executed="SaveCurrentProject_Click"/></Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="Save"/>
        <!-- Ctrl+Shift+Z 必须先于 Ctrl+Z（WPF 修饰键子集匹配 + 先注册先命中，否则 Ctrl+Shift+Z 会误触撤销）
             注意：ModifierKeys 组合用 "+" 分隔（ModifierKeysConverter），不能用逗号 -->
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Menu Grid.Row="0" HorizontalAlignment="Left">
            <MenuItem Header="文件">
                <MenuItem Header="新建"/><MenuItem Header="打开"/>
                <MenuItem Header="保存" Command="Save"/><MenuItem Header="另存为"/>
                <MenuItem Header="关闭工程" Click="CloseCurrentProject_Click"/>
            </MenuItem>
            <MenuItem Header="编辑">
                <MenuItem Header="撤销" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
            </MenuItem>
            <MenuItem Header="设置">
                <MenuItem Header="默认字体..." Click="FontDefaults_Click"/>
            </MenuItem>
            <MenuItem Header="视图">
                <MenuItem Header="文件工具" IsCheckable="True" IsChecked="True"
                          Click="ToggleToolbarBlock_Click" Tag="TbSave"/>
                <MenuItem Header="编辑工具" IsCheckable="True" IsChecked="True"
                          Click="ToggleToolbarBlock_Click" Tag="TbEdit"/>
                <MenuItem Header="构建工具" IsCheckable="True" IsChecked="True"
                          Click="ToggleToolbarBlock_Click" Tag="TbBuild"/>
                <MenuItem Header="视图工具" IsCheckable="True" IsChecked="True"
                          Click="ToggleToolbarBlock_Click" Tag="TbView"/>
                <MenuItem Header="层级工具" IsCheckable="True" IsChecked="True"
                          Click="ToggleToolbarBlock_Click" Tag="TbLayer"/>
                <MenuItem Header="对齐工具" IsCheckable="True" IsChecked="True"
                          Click="ToggleToolbarBlock_Click" Tag="TbAlign"/>
                <Separator/>
                <MenuItem Header="项目窗口" IsCheckable="True" IsChecked="True"
                          Click="ToggleAnchorable_Click" Tag="project"/>
                <MenuItem Header="控件面板" IsCheckable="True" IsChecked="True"
                          Click="ToggleAnchorable_Click" Tag="toolbox"/>
                <MenuItem Header="属性窗口" IsCheckable="True" IsChecked="True"
                          Click="ToggleAnchorable_Click" Tag="property"/>
                <MenuItem Header="CLI 控制台" IsCheckable="True" IsChecked="True"
                          Click="ToggleAnchorable_Click" Tag="cli"/>
                <Separator/>
                <MenuItem Header="恢复默认布局"/>
            </MenuItem>
            <MenuItem Header="调试">
                <MenuItem Header="生成" Click="BuildProject_Click" InputGestureText="F5"/>
            </MenuItem>
        </Menu>

        <!-- 工具栏：WrapPanel + 独立 ToolBar（带 grip 手柄 + 扁平按钮） -->
        <Border Grid.Row="1" x:Name="ToolbarHost" Background="#F0F0F0" Padding="12,2,0,2"
                MouseMove="ToolbarHost_MouseMove" MouseUp="ToolbarHost_MouseUp" MouseLeave="ToolbarHost_MouseLeave">
            <WrapPanel x:Name="ToolbarPanel">

            <ToolBar x:Name="TbSave" Width="110" Height="32" Margin="0,0,2,0"
                     PreviewMouseLeftButtonDown="Toolbar_MouseDown" Cursor="Hand">
                <Button ToolTip="新建" Click="NewProject_Click" Width="28" Height="28">📁</Button>
                <Button ToolTip="保存" Click="SaveCurrentProject_Click" Width="28" Height="28">💾</Button>
                <Button ToolTip="另存为" Click="SaveAsProject_Click" Width="28" Height="28">📑</Button>
            </ToolBar>

            <ToolBar x:Name="TbEdit" Width="210" Height="32" Margin="0,0,2,0"
                     PreviewMouseLeftButtonDown="Toolbar_MouseDown" Cursor="Hand">
                <Button ToolTip="撤销" Command="{Binding UndoCommand}" Width="28" Height="28">↩</Button>
                <Button ToolTip="恢复" Command="{Binding RedoCommand}" Width="28" Height="28">↪</Button>
                <Separator/>
                <Button ToolTip="剪切" Click="CutWidget_Click" Width="28" Height="28">✂</Button>
                <Button ToolTip="复制" Click="CopyWidget_Click" Width="28" Height="28">📋</Button>
                <Button ToolTip="粘贴" Click="PasteWidget_Click" Width="28" Height="28">📄</Button>
                <Button ToolTip="删除" Click="DeleteSelectedWidget_Click" Width="28" Height="28">🗑</Button>
            </ToolBar>

            <ToolBar x:Name="TbBuild" Width="84" Height="32" Margin="0,0,2,0"
                     PreviewMouseLeftButtonDown="Toolbar_MouseDown" Cursor="Hand">
                <Button ToolTip="编译" Click="BuildProject_Click" Width="28" Height="28">🔨</Button>
                <Button ToolTip="下载" IsEnabled="False" Width="28" Height="28">📥</Button>
            </ToolBar>

            <ToolBar x:Name="TbView" Width="116" Height="32" Margin="0,0,2,0"
                     PreviewMouseLeftButtonDown="Toolbar_MouseDown" Cursor="Hand">
                <Button ToolTip="放大" Click="ZoomIn_Click" Width="28" Height="28">🔍</Button>
                <Button ToolTip="缩小" Click="ZoomOut_Click" Width="28" Height="28">🔎</Button>
                <Button ToolTip="100%" Click="ZoomReset_Click" Width="28" Height="28">📐</Button>
            </ToolBar>

            <ToolBar x:Name="TbLayer" Width="148" Height="32" Margin="0,0,2,0"
                     PreviewMouseLeftButtonDown="Toolbar_MouseDown" Cursor="Hand">
                <Button ToolTip="置顶" Click="BringToFront_Click" Width="28" Height="28">⬆⬆</Button>
                <Button ToolTip="上移" Click="BringForward_Click" Width="28" Height="28">⬆</Button>
                <Button ToolTip="下移" Click="SendBackward_Click" Width="28" Height="28">⬇</Button>
                <Button ToolTip="置底" Click="SendToBack_Click" Width="28" Height="28">⬇⬇</Button>
            </ToolBar>

            <ToolBar x:Name="TbAlign" Width="260" Height="32" Margin="0,0,2,0"
                     PreviewMouseLeftButtonDown="Toolbar_MouseDown" Cursor="Hand">
                <Button ToolTip="矩形阵列" Click="RectArray_Click" Width="28" Height="28">⊞</Button>
                <Button ToolTip="圆形阵列" Click="CircleArray_Click" Width="28" Height="28">◯</Button>
                <Separator/>
                <Button ToolTip="左对齐" Click="AlignLeft_Click" Width="28" Height="28">◀▶</Button>
                <Button ToolTip="水平居中" Click="AlignCenterH_Click" Width="28" Height="28">◀▶</Button>
                <Button ToolTip="右对齐" Click="AlignRight_Click" Width="28" Height="28">◀▶</Button>
                <Button ToolTip="顶对齐" Click="AlignTop_Click" Width="28" Height="28">▲▼</Button>
                <Button ToolTip="垂直居中" Click="AlignCenterV_Click" Width="28" Height="28">▲▼</Button>
                <Button ToolTip="底对齐" Click="AlignBottom_Click" Width="28" Height="28">▲▼</Button>
            </ToolBar>

            </WrapPanel>
        </Border>

        <!-- 工具栏与主窗口分隔线 -->
        <Separator Grid.Row="2" Height="2" Background="#CCC" Margin="0,0,0,0"/>

        <avalon:DockingManager Grid.Row="3" x:Name="DockManager" AllowMixedOrientation="True">
            <avalon:LayoutRoot>
                <avalon:LayoutPanel Orientation="Vertical">
                    <avalon:LayoutPanel Orientation="Horizontal">

                        <!-- 左侧: 项目树 + 控件面板 -->
                        <avalon:LayoutAnchorablePane DockWidth="200">
                            <avalon:LayoutAnchorable Title="项目窗口" ContentId="project">
                                <TreeView x:Name="ProjectTreeView" ItemsSource="{Binding TreeRoots}">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:ScreenItemNode}" ItemsSource="{Binding Children}">
                                            <Grid>
                                                <StackPanel x:Name="DisplayPanel" Orientation="Horizontal">
                                                    <TextBlock Text="✅" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,4,0" FontSize="12"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                                <TextBox x:Name="EditTextBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" KeyDown="EditNameTextBox_KeyDown" Loaded="EditNameTextBox_Loaded" MinWidth="60" Visibility="Collapsed"/>
                                            </Grid>
                                            <HierarchicalDataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter TargetName="DisplayPanel" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="EditTextBox" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </HierarchicalDataTemplate.Triggers>
                                        </HierarchicalDataTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:CustomScreensRootNode}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        </HierarchicalDataTemplate>
                                        <DataTemplate DataType="{x:Type vm:AddScreenNode}">
                                            <TextBlock Text="{Binding Name}" Foreground="Green" Cursor="Hand"/>
                                        </DataTemplate>
                                    </TreeView.Resources>
                                    <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_DoubleClick"/>
                                        <EventSetter Event="MouseRightButtonDown" Handler="TreeViewItem_RightClick"/>
                                    </Style></TreeView.ItemContainerStyle>
                                </TreeView>
                            </avalon:LayoutAnchorable>
                            <avalon:LayoutAnchorable Title="控件面板" ContentId="toolbox">
                                <TabControl TabStripPlacement="Top">
                                    <TabItem Header="一般控件"><StackPanel Orientation="Vertical">
                                        <Button Content="Label" Tag="Label" Click="ToggleAddWidgetMode"/>
                                        <Button x:Name="AddButtonModeBtn" Content="Button" Tag="Button" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Text" Tag="Text" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Rectangle" Tag="Rectangle" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Line" Tag="Line" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Circle" Tag="Circle" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Ellipse" Tag="Ellipse" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Image" Tag="Image" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Numeric" Tag="Numeric" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Switch" Tag="Switch" Click="ToggleAddWidgetMode"/>
                                        <Button Content="IOField" Tag="IOField" Click="ToggleAddWidgetMode"/>
                                        <Button Content="CheckBox" Tag="CheckBox" Click="ToggleAddWidgetMode"/>
                                        <Button Content="TextBox" Tag="TextBox" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Frame" Tag="Frame" Click="ToggleAddWidgetMode"/>
                                        <Button Content="ProgressBar" Tag="ProgressBar" Click="ToggleAddWidgetMode"/>
                                    </StackPanel></TabItem>
                                    <TabItem Header="窗口控件"><StackPanel Orientation="Vertical">
                                        <Button Content="User View"/><Button Content="Alarm View"/><Button Content="Robot List"/>
                                    </StackPanel></TabItem>
                                </TabControl>
                            </avalon:LayoutAnchorable>
                        </avalon:LayoutAnchorablePane>

                        <!-- 中央: 画布 -->
                        <avalon:LayoutDocumentPane>
                            <avalon:LayoutDocument Title="画布" ContentId="canvas" CanClose="False"><Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- 画布顶部页面标签栏：显示全部自定义画面，高亮当前编辑页，点击切换 -->
                                <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="4,2">
                                    <ItemsControl ItemsSource="{Binding ScreenTabs}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="TabBorder" Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="3" Padding="8,3" Margin="0,0,4,0"
                                                        MouseLeftButtonDown="ScreenTab_Click" Cursor="Hand">
                                                    <TextBlock Text="{Binding Name}" FontSize="12"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <!-- 当前编辑页高亮 -->
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#0078D4"/>
                                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0078D4"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <Popup x:Name="WidgetContextMenu" Placement="Absolute" StaysOpen="False" AllowsTransparency="True" Grid.RowSpan="2">
                                    <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="2">
                                        <StackPanel>
                                                <Button Content="✂ 剪切" Click="CutWidget_Click" Width="80" Height="28" Margin="2"/>
                                                <Button Content="📋 复制" Click="CopyWidget_Click" Width="80" Height="28" Margin="2"/>
                                                <Button x:Name="WidgetPasteBtn" Content="📄 粘贴" Click="PasteWidget_Click" Width="80" Height="28" Margin="2"/>
                                                <Separator/>
                                                <Button Content="🗑 删除" Click="DeleteWidget_Click" Width="80" Height="28" Margin="2"/>
                                                <Separator/>
                                                <Button Content="📋 属性" Click="ShowWidgetProperty_Click" Width="80" Height="28" Margin="2"/>
                                            </StackPanel>
                                    </Border>
                                </Popup>
                                <Popup x:Name="TreeContextMenu" Placement="Absolute" StaysOpen="True" AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="2">
                                        <StackPanel>
                                            <Button x:Name="CanvasPasteBtn" Content="📄 粘贴" Click="PasteAtPosition" Width="100" Height="28" Margin="2"/>
                                            <Button Content="📋 属性" Click="ShowCanvasProperty_Click" Width="100" Height="28" Margin="2"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <!-- 树节点右键菜单（复制/剪切/粘贴/删除/重命名；与画布菜单分开，避免共用 Popup 内容错位） -->
                                <Popup x:Name="TreeScreenMenu" Placement="Absolute" StaysOpen="True" AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="2">
                                        <StackPanel>
                                            <Button Content="✂ 剪切画面" Click="CutScreen_Click" Width="100" Height="28" Margin="2"/>
                                            <Button Content="📋 复制画面" Click="CopyScreen_Click" Width="100" Height="28" Margin="2"/>
                                            <Button x:Name="ScreenPasteBtn" Content="📄 粘贴画面" Click="PasteScreen_Click" Width="100" Height="28" Margin="2"/>
                                            <Separator/>
                                            <Button Content="✏ 重命名" Click="RenameScreen_Click" Width="100" Height="28" Margin="2"/>
                                            <Button Content="🗑 删除画面" Click="DeleteScreen_Click" Width="100" Height="28" Margin="2"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <Border BorderBrush="Black" Background="Gray" BorderThickness="2" Margin="3" x:Name="canvasContainer" Grid.Row="1"
                                        PreviewMouseRightButtonDown="Canvas_PreviewRightButtonDown"
                                        PreviewMouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                        PreviewMouseMove="Canvas_MouseMove" PreviewMouseLeftButtonUp="Canvas_MouseLeftButtonUp">
                                    <Grid>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Canvas x:Name="DrawingCanvas" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="{StaticResource DotGridBrush}" Width="{Binding DeviceWidth}" Height="{Binding DeviceHeight}"
                                                MouseDown="Canvas_MouseDown">
                                            <!-- 框选矩形 -->
                                            <Rectangle x:Name="MarqueeRect" Stroke="Blue" StrokeThickness="2" Fill="#300000FF"
                                                       Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="1001"/>
                                            <!-- 两点式绘制预览（Line/Circle/Ellipse/Rectangle） -->
                                            <Path x:Name="DrawPreviewShape" Stroke="#1E90FF" StrokeThickness="1.5" Fill="#301E90FF"
                                                  Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="1002"/>
                                            <!-- 阵列辅助线预览（虚线示意落位，不移动控件） -->
                                            <Path x:Name="ArrayGuideShape" Stroke="#FF7F00" StrokeThickness="2" Fill="#20FF7F00"
                                                  StrokeDashArray="5,3" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="1003"/>
                                            <!-- 阵列落点标记：蓝色空心方块 + 序号数字（自绘覆盖层） -->
                                            <ctrl:ArrayGuideOverlay x:Name="ArrayGuideOverlay"
                                                  Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="1004"/>
                                        </Canvas>
                                    </ScrollViewer>
                                    <!-- 缩放比例 -->
                                    <TextBlock x:Name="ZoomLabel" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               Foreground="Gray" FontSize="12" Margin="0,0,8,4"/>
                                    </Grid>
                                </Border>
                            </Grid></avalon:LayoutDocument>
                        </avalon:LayoutDocumentPane>

                        <!-- 右侧: 属性窗口 -->
                        <avalon:LayoutAnchorablePane DockWidth="260">
                            <avalon:LayoutAnchorable Title="属性" ContentId="property">
                                <Grid Margin="4" DataContext="{Binding PropertyVM, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock Text="请选择一个控件" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" FontSize="14">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsPropertyVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding IsPropertyVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding WidgetTypeName, StringFormat='属性 - {0}'}" FontWeight="Bold" FontSize="13" Margin="4,2"/>
                                            <Separator Margin="4,2"/>
                                            <ContentControl Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="Screen"><Setter Property="ContentTemplate" Value="{StaticResource PropScreen}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="ButtonWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropButton}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="MultiSelect"><Setter Property="ContentTemplate" Value="{StaticResource PropMultiSelect}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="TextWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropText}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="RectangleWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropRect}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="LabelWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropLabelWidget}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="ImageWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropImage}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="NumericDisplayWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropNumericDisplay}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="SwitchWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropSwitch}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="LineWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropLine}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="CircleWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropCircle}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="EllipseWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropEllipse}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="IOFieldWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropIOField}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="CheckBoxWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropCheckBox}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="TextBoxWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropTextBoxWidget}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="FrameWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropFrame}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="ProgressBarWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropProgressBar}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style></ContentControl.Style></ContentControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </avalon:LayoutAnchorable>
                        </avalon:LayoutAnchorablePane>
                    </avalon:LayoutPanel>

                    <!-- 底部: CLI -->
                    <avalon:LayoutAnchorablePane DockHeight="180">
                        <avalon:LayoutAnchorable Title="CLI 控制台" ContentId="cli">
                            <!-- Background=Transparent：空白区可命中测试，点击任意处才能聚焦输入框（wpf-event-routing §1） -->
                            <Grid PreviewMouseDown="CliPanel_PreviewMouseDown" Background="Transparent">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                                <ScrollViewer Grid.Row="0" x:Name="CliOutputScroller" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="CliOutput" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                             Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0" TextWrapping="Wrap"/>
                                </ScrollViewer>
                                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="LightGray"/>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text=">" FontFamily="Consolas" FontSize="13" Foreground="LimeGreen" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="CliInput" FontFamily="Consolas" FontSize="13"
                                             Background="#1E1E1E" Foreground="White" BorderThickness="0"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="120"
                                             PreviewKeyDown="CliInput_KeyDown"/>
                                </Grid>
                            </Grid>
                        </avalon:LayoutAnchorable>
                    </avalon:LayoutAnchorablePane>
                </avalon:LayoutPanel>
            </avalon:LayoutRoot>
        </avalon:DockingManager>

    </Grid>
</Window>
