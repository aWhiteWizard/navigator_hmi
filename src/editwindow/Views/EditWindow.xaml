                    <TextBlock Text="（无绑定）" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#777777" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FrameListRef}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="缺省值:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding FrameDefaultIndex, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" ToolTip="未绑定变量/变量值无效时显示的列表项索引（0=第1项）" KeyDown="PropField_KeyDown" />
            </Grid>
            <TextBlock Text="外观" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Title:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding FrameTitle, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropTextBox}" KeyDown="PropField_KeyDown" />
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="FillColor:" Style="{StaticResource PropLabel}"/>
                <ctrl:ColorPickerControl Grid.Column="1" Value="{Binding FrameFillColor, Mode=TwoWay}"/>
            </Grid>
            <TextBlock Text="字体" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Font:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding FrameFontFamily, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Source" DisplayMemberPath="Source" ItemsSource="{Binding Source={StaticResource SystemFonts}}" Style="{StaticResource PropComboBox}"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Size:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding FrameFontSize, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown" />
                <Label Grid.Column="2" Content="Bold:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="3" SelectedValue="{Binding FrameFontWeight, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Normal"/><ComboBoxItem Content="Bold"/>
                </ComboBox>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Style:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding FrameFontStyle, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Normal"/><ComboBoxItem Content="Italic"/>
                </ComboBox>
            </Grid>
</StackPanel></DataTemplate>

        <!-- ProgressBarWidget 属性 -->
        <DataTemplate x:Key="PropProgressBar"><StackPanel>
            <ContentControl ContentTemplate="{StaticResource PropPosition}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropSize}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropName}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropBinding}" Content="{Binding}"/>
            <Separator Margin="4,2"/>
            <TextBlock Text="参数" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Min:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding ProgressMin, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown" />
                <Label Grid.Column="2" Content="Max:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="3" Text="{Binding ProgressMax, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown" />
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="FillColor:" Style="{StaticResource PropLabel}"/>
                <ctrl:ColorPickerControl Grid.Column="1" Value="{Binding ProgressFillColor, Mode=TwoWay}"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Style:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" SelectedValue="{Binding ProgressFillStyle, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Style="{StaticResource PropComboBox}">
                    <ComboBoxItem Content="Solid"/><ComboBoxItem Content="Diagonal"/><ComboBoxItem Content="Grid"/>
                </ComboBox>
            </Grid></StackPanel></DataTemplate>
    <!-- C13 日期时间控件属性 -->
    <DataTemplate x:Key="PropDateTime"><StackPanel>
            <ContentControl ContentTemplate="{StaticResource PropPosition}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropSize}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropName}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropBinding}" Content="{Binding}"/>
            <Separator Margin="4,2"/>
            <TextBlock Text="参数" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="格式:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" Text="{Binding DateTimeFormat, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Style="{StaticResource PropComboBox}" ToolTip="DateTime 格式（可编辑输入自定义；选中项为常用格式）">
                                        <ComboBoxItem Content="yyyy-MM-dd HH:mm:ss"/><ComboBoxItem Content="yyyy-MM-dd"/><ComboBoxItem Content="HH:mm:ss"/><ComboBoxItem Content="yyyy/MM/dd HH:mm:ss"/><ComboBoxItem Content="yyyy年MM月dd日"/><ComboBoxItem Content="HH:mm"/><ComboBoxItem Content="yyyy:MM:dd HH:mm:ss"/></ComboBox>
            </Grid>
        </StackPanel></DataTemplate>
        <!-- W4 窗口控件属性（UserView/AlarmView/RobotList 共用 + 各自开关） -->
        <DataTemplate x:Key="PropWindow"><StackPanel>
            <ContentControl ContentTemplate="{StaticResource PropPosition}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropSize}" Content="{Binding}"/>
            <ContentControl ContentTemplate="{StaticResource PropName}" Content="{Binding}"/>
            <Separator Margin="4,2"/>
            <TextBlock Text="窗口" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="标题:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding WindowTitle, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropTextBox}" KeyDown="PropField_KeyDown"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="标题栏:" Style="{StaticResource PropLabel}"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding WindowShowTitleBar}" VerticalAlignment="Center"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="背景色:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding WindowFillColor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropTextBox}" KeyDown="PropField_KeyDown"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="边框色:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding WindowBorderColor, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropTextBox}" KeyDown="PropField_KeyDown"/>
            </Grid>
            <!-- UserView 显示开关 -->
            <TextBlock Text="UserView 显示" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="用户名:" Style="{StaticResource PropLabel}"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding WindowShowUserName}" VerticalAlignment="Center"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="角色:" Style="{StaticResource PropLabel}"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding WindowShowRole}" VerticalAlignment="Center"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="运行模式:" Style="{StaticResource PropLabel}"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding WindowShowMode}" VerticalAlignment="Center"/>
            </Grid>
            <!-- AlarmView -->
            <TextBlock Text="AlarmView" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="含历史:" Style="{StaticResource PropLabel}"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding WindowShowHistory}" VerticalAlignment="Center" ToolTip="false=仅活动报警"/>
            </Grid>
            <!-- RobotList：卡片尺寸 + 信息开关 + 绑定设备 + 选中变量 -->
            <TextBlock Text="RobotList 卡片" Style="{StaticResource PropGroupHeader}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="卡片宽:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding WindowCardWidth, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="卡片高:" Style="{StaticResource PropLabel}"/>
                <TextBox Grid.Column="1" Text="{Binding WindowCardHeight, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" KeyDown="PropField_KeyDown"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="显示编号:" Style="{StaticResource PropLabel}"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding WindowCardShowNumber}" VerticalAlignment="Center"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="显示状态:" Style="{StaticResource PropLabel}"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding WindowCardShowStatus}" VerticalAlignment="Center"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="显示位置:" Style="{StaticResource PropLabel}"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding WindowCardShowLocation}" VerticalAlignment="Center"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="绑定设备:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding WindowDevices}" SelectedItem="{Binding WindowBoundDevice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PropComboBox}" ToolTip="RobotList 两态过滤：选设备 → 变量仅该设备（Tag.DeviceName）；「（仅内部变量）」→ 仅内部变量"/>
            </Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="选中变量:" Style="{StaticResource PropLabel}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding WindowDeviceTags}" SelectedValue="{Binding WindowSelectedTag, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Name" DisplayMemberPath="Name" Style="{StaticResource PropComboBox}" ToolTip="RobotList 选中编号写入变量（STRING）"/>
            </Grid>
            <!-- RobotSlots 绑定表 -->
            <TextBlock Text="机器人绑定组" Style="{StaticResource PropGroupHeader}"/>
            <ItemsControl ItemsSource="{Binding RobotSlotRows}" Margin="0,2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="10"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Tags}" SelectedValue="{Binding SelectedTag, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Name" DisplayMemberPath="Name" FontSize="10" Height="22"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel></DataTemplate>
    </Window.Resources>

    <Window.CommandBindings><CommandBinding Command="Save" Executed="SaveCurrentProject_Click"/><CommandBinding Command="Help" Executed="Help_Click"/></Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="Save"/>
        <!-- Ctrl+Shift+Z 必须先于 Ctrl+Z（WPF 修饰键子集匹配 + 先注册先命中，否则 Ctrl+Shift+Z 会误触撤销）
             注意：ModifierKeys 组合用 "+" 分隔（ModifierKeysConverter），不能用逗号 -->
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="F1" Command="{x:Static ApplicationCommands.Help}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Menu Grid.Row="0" HorizontalAlignment="Left">
            <MenuItem Header="文件">
                <MenuItem Header="新建"/><MenuItem Header="打开"/>
                <MenuItem Header="保存" Command="Save"/><MenuItem Header="另存为"/>
                <MenuItem Header="关闭工程" Click="CloseCurrentProject_Click"/>
            </MenuItem>
            <MenuItem Header="编辑">
                <MenuItem Header="撤销" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"/>
            </MenuItem>
            <MenuItem Header="设置">
                <MenuItem Header="默认字体..." Click="FontDefaults_Click"/>
                <MenuItem Header="AI 助手设置..." Click="AiSettings_Click"/>
            </MenuItem>
            <MenuItem Header="视图">
                <MenuItem Header="文件工具" IsCheckable="True" IsChecked="True"
                          Click="ToggleToolbarBlock_Click" Tag="TbSave"/>
                <MenuItem Header="编辑工具" IsCheckable="True" IsChecked="True"
                          Click="ToggleToolbarBlock_Click" Tag="TbEdit"/>
                <MenuItem Header="构建工具" IsCheckable="True" IsChecked="True"
                          Click="ToggleToolbarBlock_Click" Tag="TbBuild"/>
                <MenuItem Header="视图工具" IsCheckable="True" IsChecked="True"
                          Click="ToggleToolbarBlock_Click" Tag="TbView"/>
                <MenuItem Header="层级工具" IsCheckable="True" IsChecked="True"
                          Click="ToggleToolbarBlock_Click" Tag="TbLayer"/>
                <MenuItem Header="对齐工具" IsCheckable="True" IsChecked="True"
                          Click="ToggleToolbarBlock_Click" Tag="TbAlign"/>
                <Separator/>
                <MenuItem Header="项目窗口" IsCheckable="True" IsChecked="True"
                          Click="ToggleAnchorable_Click" Tag="project"/>
                <MenuItem Header="控件面板" IsCheckable="True" IsChecked="True"
                          Click="ToggleAnchorable_Click" Tag="toolbox"/>
                <MenuItem Header="属性窗口" IsCheckable="True" IsChecked="True"
                          Click="ToggleAnchorable_Click" Tag="property"/>
                <MenuItem Header="CLI 控制台" IsCheckable="True" IsChecked="True"
                          Click="ToggleAnchorable_Click" Tag="cli"/>
                <Separator/>
                <MenuItem Header="恢复默认布局"/>
            </MenuItem>
            <MenuItem Header="调试">
                <MenuItem Header="生成" Click="BuildProject_Click" InputGestureText="F5"/>
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="帮助文档" Click="Help_Click" InputGestureText="F1"/>
            </MenuItem>
        </Menu>

        <!-- 工具栏：WrapPanel + 独立 ToolBar（带 grip 手柄 + 扁平按钮） -->
        <Border Grid.Row="1" x:Name="ToolbarHost" Background="#F0F0F0" Padding="12,2,0,2"
                MouseMove="ToolbarHost_MouseMove" MouseUp="ToolbarHost_MouseUp" MouseLeave="ToolbarHost_MouseLeave">
            <WrapPanel x:Name="ToolbarPanel">

            <ToolBar x:Name="TbSave" Width="110" Height="32" Margin="0,0,2,0"
                     PreviewMouseLeftButtonDown="Toolbar_MouseDown" Cursor="Hand">
                <Button ToolTip="新建" Click="NewProject_Click" Width="28" Height="28">📁</Button>
                <Button ToolTip="保存" Click="SaveCurrentProject_Click" Width="28" Height="28">💾</Button>
                <Button ToolTip="另存为" Click="SaveAsProject_Click" Width="28" Height="28">📑</Button>
            </ToolBar>

            <ToolBar x:Name="TbEdit" Width="210" Height="32" Margin="0,0,2,0"
                     PreviewMouseLeftButtonDown="Toolbar_MouseDown" Cursor="Hand">
                <Button ToolTip="撤销" Command="{Binding UndoCommand}" Width="28" Height="28">↩</Button>
                <Button ToolTip="恢复" Command="{Binding RedoCommand}" Width="28" Height="28">↪</Button>
                <Separator/>
                <Button ToolTip="剪切" Click="CutWidget_Click" Width="28" Height="28">✂</Button>
                <Button ToolTip="复制" Click="CopyWidget_Click" Width="28" Height="28">📋</Button>
                <Button ToolTip="粘贴" Click="PasteWidget_Click" Width="28" Height="28">📄</Button>
                <Button ToolTip="删除" Click="DeleteSelectedWidget_Click" Width="28" Height="28">🗑</Button>
            </ToolBar>

            <ToolBar x:Name="TbBuild" Width="84" Height="32" Margin="0,0,2,0"
                     PreviewMouseLeftButtonDown="Toolbar_MouseDown" Cursor="Hand">
                <Button ToolTip="编译" Click="BuildProject_Click" Width="28" Height="28">🔨</Button>
                <Button ToolTip="下载" IsEnabled="False" Width="28" Height="28">📥</Button>
            </ToolBar>

            <ToolBar x:Name="TbView" Width="116" Height="32" Margin="0,0,2,0"
                     PreviewMouseLeftButtonDown="Toolbar_MouseDown" Cursor="Hand">
                <Button ToolTip="放大" Click="ZoomIn_Click" Width="28" Height="28">🔍</Button>
                <Button ToolTip="缩小" Click="ZoomOut_Click" Width="28" Height="28">🔎</Button>
                <Button ToolTip="100%" Click="ZoomReset_Click" Width="28" Height="28">📐</Button>
            </ToolBar>

            <ToolBar x:Name="TbLayer" Width="148" Height="32" Margin="0,0,2,0"
                     PreviewMouseLeftButtonDown="Toolbar_MouseDown" Cursor="Hand">
                <Button ToolTip="置顶" Click="BringToFront_Click" Width="28" Height="28">⬆⬆</Button>
                <Button ToolTip="上移" Click="BringForward_Click" Width="28" Height="28">⬆</Button>
                <Button ToolTip="下移" Click="SendBackward_Click" Width="28" Height="28">⬇</Button>
                <Button ToolTip="置底" Click="SendToBack_Click" Width="28" Height="28">⬇⬇</Button>
            </ToolBar>

            <ToolBar x:Name="TbAlign" Width="260" Height="32" Margin="0,0,2,0"
                     PreviewMouseLeftButtonDown="Toolbar_MouseDown" Cursor="Hand">
                <Button ToolTip="矩形阵列" Click="RectArray_Click" Width="28" Height="28">⊞</Button>
                <Button ToolTip="圆形阵列" Click="CircleArray_Click" Width="28" Height="28">◯</Button>
                <Separator/>
                <Button ToolTip="左对齐" Click="AlignLeft_Click" Width="28" Height="28" Padding="0">
                    <Path Data="M4,5 L16,5 M4,9 L12,9 M4,13 L14,13 M4,4 L4,16" Stroke="#444444" StrokeThickness="1.5" Stretch="Uniform" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="水平居中" Click="AlignCenterH_Click" Width="28" Height="28" Padding="0">
                    <Path Data="M4,5 L16,5 M6,9 L14,9 M5,13 L15,13 M10,4 L10,16" Stroke="#444444" StrokeThickness="1.5" Stretch="Uniform" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="右对齐" Click="AlignRight_Click" Width="28" Height="28" Padding="0">
                    <Path Data="M4,5 L16,5 M8,9 L16,9 M6,13 L16,13 M16,4 L16,16" Stroke="#444444" StrokeThickness="1.5" Stretch="Uniform" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="顶对齐" Click="AlignTop_Click" Width="28" Height="28" Padding="0">
                    <Path Data="M5,4 L5,16 M9,4 L9,12 M13,4 L13,14 M4,4 L16,4" Stroke="#444444" StrokeThickness="1.5" Stretch="Uniform" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="垂直居中" Click="AlignCenterV_Click" Width="28" Height="28" Padding="0">
                    <Path Data="M5,4 L5,16 M9,6 L9,14 M13,5 L13,15 M4,10 L16,10" Stroke="#444444" StrokeThickness="1.5" Stretch="Uniform" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="底对齐" Click="AlignBottom_Click" Width="28" Height="28" Padding="0">
                    <Path Data="M5,4 L5,16 M9,8 L9,16 M13,6 L13,16 M4,16 L16,16" Stroke="#444444" StrokeThickness="1.5" Stretch="Uniform" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </ToolBar>

            <ToolBar x:Name="TbAi" Width="105" Height="32" Margin="0,0,2,0"
                     PreviewMouseLeftButtonDown="Toolbar_MouseDown" Cursor="Hand">
                <ToggleButton x:Name="AiBallToggle" ToolTip="AI 悬浮窗（开/关）" Width="28" Height="28"
                              Checked="AiBallToggle_Checked" Unchecked="AiBallToggle_Unchecked">🛰</ToggleButton>
                <Button ToolTip="AI 设置" Click="AiSettings_Click" Width="28" Height="28">⚙</Button>
            </ToolBar>

            </WrapPanel>
        </Border>

        <!-- 工具栏与主窗口分隔线 -->
        <Separator Grid.Row="2" Height="2" Background="#CCC" Margin="0,0,0,0"/>

        <avalon:DockingManager Grid.Row="3" x:Name="DockManager" AllowMixedOrientation="True">
            <avalon:LayoutRoot>
                <avalon:LayoutPanel Orientation="Vertical">
                    <avalon:LayoutPanel Orientation="Horizontal">

                        <!-- 左侧: 项目树 + 控件面板 -->
                        <avalon:LayoutAnchorablePane DockWidth="200">
                            <avalon:LayoutAnchorable Title="项目窗口" ContentId="project">
                                <TreeView x:Name="ProjectTreeView" ItemsSource="{Binding TreeRoots}" MouseRightButtonDown="ProjectTree_RightClick" Background="Transparent"
                                          AllowDrop="True" DragOver="ProjectTree_DragOver" Drop="ProjectTree_Drop">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:ScreenItemNode}" ItemsSource="{Binding Children}">
                                            <Grid>
                                                <StackPanel x:Name="DisplayPanel" Orientation="Horizontal">
                                                    <TextBlock Text="✅" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,4,0" FontSize="12"/>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                                <TextBox x:Name="EditTextBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" KeyDown="EditNameTextBox_KeyDown" Loaded="EditNameTextBox_Loaded" MinWidth="60" Visibility="Collapsed"/>
                                            </Grid>
                                            <HierarchicalDataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                    <Setter TargetName="DisplayPanel" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="EditTextBox" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </HierarchicalDataTemplate.Triggers>
                                        </HierarchicalDataTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:CustomScreensRootNode}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        </HierarchicalDataTemplate>
                                        <DataTemplate DataType="{x:Type vm:AddScreenNode}">
                                            <TextBlock Text="{Binding Name}" Foreground="Green" Cursor="Hand"/>
                                        </DataTemplate>
                                        <!-- 通信变量 → 变量：缺模板会显示类名（WPF 无匹配模板时 ToString） -->
                                        <HierarchicalDataTemplate DataType="{x:Type vm:CommunicationRootNode}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        </HierarchicalDataTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:ListRootNode}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        </HierarchicalDataTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:AlarmRootNode}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        </HierarchicalDataTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:UserRootNode}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        </HierarchicalDataTemplate>
                                        <DataTemplate DataType="{x:Type vm:VariableManagerNode}">
                                            <!-- 与画面节点一致的选中样式（✅ 高亮 + 默认字体颜色） -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✅" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,4,0" FontSize="12"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:DeviceConfigNode}">
                                            <!-- 与画面节点一致的选中样式（✅ 高亮 + 默认字体颜色） -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✅" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,4,0" FontSize="12"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:AlarmConfigNode}">
                                            <!-- 与画面节点一致的选中样式（✅ 高亮 + 默认字体颜色） -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✅" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,4,0" FontSize="12"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:UserNameNode}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✅" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,4,0" FontSize="12"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:UserGroupNode}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✅" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,4,0" FontSize="12"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:UserSecurityNode}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✅" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,4,0" FontSize="12"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:TextListRootNode}">
                                            <!-- 与画面节点一致的选中样式（✅ 高亮 + 默认字体颜色） -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✅" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,4,0" FontSize="12"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                        <DataTemplate DataType="{x:Type vm:ImageListRootNode}">
                                            <!-- 与画面节点一致的选中样式（✅ 高亮 + 默认字体颜色） -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✅" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,4,0" FontSize="12"/>
                                                <TextBlock Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </TreeView.Resources>
                                    <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_DoubleClick"/>
                                        <EventSetter Event="MouseRightButtonDown" Handler="TreeViewItem_RightClick"/>
                                    </Style></TreeView.ItemContainerStyle>
                                </TreeView>
                            </avalon:LayoutAnchorable>
                            <avalon:LayoutAnchorable Title="控件面板" ContentId="toolbox">
                                <TabControl TabStripPlacement="Top">
                                    <TabItem Header="一般控件"><StackPanel Orientation="Vertical">
                                        <Button Content="Label" Tag="Label" Click="ToggleAddWidgetMode"/>
                                        <Button x:Name="AddButtonModeBtn" Content="Button" Tag="Button" Click="ToggleAddWidgetMode"/>
                                                                                <Button Content="Rectangle" Tag="Rectangle" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Line" Tag="Line" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Circle" Tag="Circle" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Ellipse" Tag="Ellipse" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Image" Tag="Image" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Numeric" Tag="Numeric" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Switch" Tag="Switch" Click="ToggleAddWidgetMode"/>
                                        <Button Content="IOField" Tag="IOField" Click="ToggleAddWidgetMode"/>
                                        <Button Content="CheckBox" Tag="CheckBox" Click="ToggleAddWidgetMode"/>
                                        <Button Content="TextList" Tag="TextList" Click="ToggleAddWidgetMode"/>
                                        <Button Content="Frame" Tag="Frame" Click="ToggleAddWidgetMode"/>
                                        <Button Content="ProgressBar" Tag="ProgressBar" Click="ToggleAddWidgetMode"/>
                                            <Button Content="DateTime" Tag="DateTime" Click="ToggleAddWidgetMode"/>
                                    </StackPanel></TabItem>
                                    <TabItem Header="窗口控件"><StackPanel Orientation="Vertical">
                                        <Button Content="User View" Tag="UserView" Click="ToggleAddWidgetMode" ToolTip="用户视图控件（头像/用户名/角色/模式/登录）"/>
                                        <Button Content="Alarm View" Tag="AlarmView" Click="ToggleAddWidgetMode" ToolTip="报警视图控件（活动报警列表/级别色标/确认）"/>
                                        <Button Content="Robot List" Tag="RobotList" Click="ToggleAddWidgetMode" ToolTip="机器人列表控件（卡片网格/绑定变量驱动）"/>
                                    </StackPanel></TabItem>
                                </TabControl>
                            </avalon:LayoutAnchorable>
                        </avalon:LayoutAnchorablePane>

                        <!-- 中央: 画布 -->
                        <avalon:LayoutDocumentPane>
                            <avalon:LayoutDocument Title="画布" ContentId="canvas" CanClose="False" CanFloat="False"><Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- 画布顶部页面标签栏：画面 Tab（打开才显示）+ 变量管理器 Tab（固定），点击切换，可关闭 -->
                                <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="4,2">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- 变量管理器 Tab（由「通信变量→变量」树节点双击打开，打开才显示，激活高亮） -->
                                        <Border x:Name="VarManagerTab" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,4,0"
                                                Cursor="Hand" MouseLeftButtonDown="VarManagerTab_Click"
                                                Visibility="{Binding VariableManagerTabOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                    <Setter Property="BorderBrush" Value="#B0B0B0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding VariableManagerActive}" Value="True">
                                                            <Setter Property="Background" Value="#0078D4"/>
                                                            <Setter Property="BorderBrush" Value="#0078D4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="变量" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text=" ✕" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="4,0,0,0"
                                                           Cursor="Hand" MouseLeftButtonDown="VarManagerTabClose_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- 通讯配置 Tab（由「通信变量→通讯」树节点双击打开，打开才显示，激活高亮） -->
                                        <Border x:Name="CommTab" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,4,0"
                                                Cursor="Hand" MouseLeftButtonDown="CommTab_Click"
                                                Visibility="{Binding CommunicationTabOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                    <Setter Property="BorderBrush" Value="#B0B0B0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CommunicationActive}" Value="True">
                                                            <Setter Property="Background" Value="#0078D4"/>
                                                            <Setter Property="BorderBrush" Value="#0078D4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="通讯" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text=" ✕" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="4,0,0,0"
                                                           Cursor="Hand" MouseLeftButtonDown="CommTabClose_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- 报警配置 Tab（由「通信变量→报警」树节点双击打开，打开才显示，激活高亮） -->
                                        <Border x:Name="AlarmTab" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,4,0"
                                                Cursor="Hand" MouseLeftButtonDown="AlarmTab_Click"
                                                Visibility="{Binding AlarmTabOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                    <Setter Property="BorderBrush" Value="#B0B0B0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AlarmActive}" Value="True">
                                                            <Setter Property="Background" Value="#0078D4"/>
                                                            <Setter Property="BorderBrush" Value="#0078D4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="报警" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text=" ✕" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="4,0,0,0"
                                                           Cursor="Hand" MouseLeftButtonDown="AlarmTabClose_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- W3 用户 Tab（由「用户」树节点双击打开，打开才显示，激活高亮） -->
                                        <Border x:Name="UserTab" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,4,0"
                                                Cursor="Hand" MouseLeftButtonDown="UserTab_Click"
                                                Visibility="{Binding UserTabOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                    <Setter Property="BorderBrush" Value="#B0B0B0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UserActive}" Value="True">
                                                            <Setter Property="Background" Value="#0078D4"/>
                                                            <Setter Property="BorderBrush" Value="#0078D4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="用户" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text=" ✕" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="4,0,0,0"
                                                           Cursor="Hand" MouseLeftButtonDown="UserTabClose_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- 列表管理 Tab（由「通信变量→列表→文本/图片列表」树节点双击打开，打开才显示，激活高亮） -->
                                        <Border x:Name="ListManagerTab" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,4,0"
                                                Cursor="Hand" MouseLeftButtonDown="ListManagerTab_Click"
                                                Visibility="{Binding ListManagerTabOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                    <Setter Property="BorderBrush" Value="#B0B0B0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ListManagerActive}" Value="True">
                                                            <Setter Property="Background" Value="#0078D4"/>
                                                            <Setter Property="BorderBrush" Value="#0078D4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="列表" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text=" ✕" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="4,0,0,0"
                                                           Cursor="Hand" MouseLeftButtonDown="ListManagerTabClose_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding OpenScreens}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="TabBorder" Background="#E0E0E0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,4,0"
                                                        MouseLeftButtonDown="ScreenTab_Click" Cursor="Hand"
                                                        AllowDrop="True" DragOver="ScreenTab_DragOver" Drop="ScreenTab_Drop">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                                                        <!-- 关闭按钮 -->
                                                        <TextBlock Text=" ✕" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="4,0,0,0"
                                                                   Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="ScreenTabClose_Click"/>
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <!-- 当前编辑页高亮；变量管理器/通讯/列表激活时画面 Tab 不高亮（高亮互斥，避免双蓝） -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsCurrent}" Value="True"/>
                                                            <Condition Binding="{Binding DataContext.VariableManagerActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                            <Condition Binding="{Binding DataContext.CommunicationActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                            <Condition Binding="{Binding DataContext.ListManagerActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                            <Condition Binding="{Binding DataContext.AlarmActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                            <Condition Binding="{Binding DataContext.UserActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#0078D4"/>
                                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0078D4"/>
                                                    </MultiDataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Popup x:Name="WidgetContextMenu" Placement="Absolute" StaysOpen="False" AllowsTransparency="True" Grid.RowSpan="2">
                                    <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="2">
                                        <StackPanel>
                                                <Button Content="✂ 剪切" Click="CutWidget_Click" Width="80" Height="28" Margin="2"/>
                                                <Button Content="📋 复制" Click="CopyWidget_Click" Width="80" Height="28" Margin="2"/>
                                                <Button x:Name="WidgetPasteBtn" Content="📄 粘贴" Click="PasteWidget_Click" Width="80" Height="28" Margin="2"/>
                                                <Separator/>
                                                <Button Content="🗑 删除" Click="DeleteWidget_Click" Width="80" Height="28" Margin="2"/>
                                                <Separator/>
                                                <Button Content="📋 属性" Click="ShowWidgetProperty_Click" Width="80" Height="28" Margin="2"/>
                                            </StackPanel>
                                    </Border>
                                </Popup>
                                <Popup x:Name="TreeContextMenu" Placement="Absolute" StaysOpen="True" AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="2">
                                        <StackPanel>
                                            <Button x:Name="CanvasPasteBtn" Content="📄 粘贴" Click="PasteAtPosition" Width="100" Height="28" Margin="2"/>
                                            <Button Content="📋 属性" Click="ShowCanvasProperty_Click" Width="100" Height="28" Margin="2"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <!-- 树节点右键菜单（复制/剪切/粘贴/删除/重命名；与画布菜单分开，避免共用 Popup 内容错位） -->
                                <Popup x:Name="TreeScreenMenu" Placement="Absolute" StaysOpen="True" AllowsTransparency="True">
                                    <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4" Padding="2">
                                        <StackPanel>
                                            <Button Content="✂ 剪切画面" Click="CutScreen_Click" Width="100" Height="28" Margin="2"/>
                                            <Button Content="📋 复制画面" Click="CopyScreen_Click" Width="100" Height="28" Margin="2"/>
                                            <Button x:Name="ScreenPasteBtn" Content="📄 粘贴画面" Click="PasteScreen_Click" Width="100" Height="28" Margin="2"/>
                                            <Separator/>
                                            <Button Content="✏ 重命名" Click="RenameScreen_Click" Width="100" Height="28" Margin="2"/>
                                            <Button Content="🗑 删除画面" Click="DeleteScreen_Click" Width="100" Height="28" Margin="2"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <Border BorderBrush="Black" Background="Gray" BorderThickness="2" Margin="3" x:Name="canvasContainer" Grid.Row="1"
                                        PreviewMouseRightButtonDown="Canvas_PreviewRightButtonDown"
                                        PreviewMouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                        PreviewMouseMove="Canvas_MouseMove" PreviewMouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                                        AllowDrop="True" DragOver="Canvas_DragOver" Drop="Canvas_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <!-- 变量管理器/通讯/列表/报警/用户激活时隐藏画布（同一位置切换）
                                                     用 Hidden 而非 Collapsed：不销毁画布大量控件的布局树，切页/切回更快；
                                                     Hidden 不渲染且不参与命中测试，变量/通讯/列表 Grid 在 Z 序上正常显示 -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding VariableManagerActive}" Value="False"/>
                                                        <Condition Binding="{Binding CommunicationActive}" Value="False"/>
                                                        <Condition Binding="{Binding ListManagerActive}" Value="False"/>
                                                        <Condition Binding="{Binding AlarmActive}" Value="False"/>
                                                        <Condition Binding="{Binding UserActive}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding VariableManagerActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CommunicationActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ListManagerActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding AlarmActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UserActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <!-- 世界地图底图（Mapsui）：仅 WorldMap 画面显示；与画布同尺寸同位置叠放（ScrollViewer 内滚动跟随），
                                             画布透明 + 世界地图时画布穿透 → 地图透出且可交互（平移缩放）；非世界地图时 Collapsed 不显示不命中 -->
                                        <Grid Width="{Binding DeviceWidth}" Height="{Binding DeviceHeight}">
                                            <mapsui:MapControl x:Name="WorldMapControl" Panel.ZIndex="0"
                                                    Width="{Binding DeviceWidth}" Height="{Binding DeviceHeight}"
                                                    Visibility="{Binding DataContext.IsWorldMapActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                                                    IsHitTestVisible="{Binding DataContext.IsWorldMapActive, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}"/>
                                            <Canvas x:Name="DrawingCanvas" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Width="{Binding DeviceWidth}" Height="{Binding DeviceHeight}"
                                                    IsHitTestVisible="{Binding DataContext.IsWorldMapActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}"
                                                    Focusable="True" MouseDown="Canvas_MouseDown">
                                            <Canvas.Style>
                                                <Style TargetType="Canvas">
                                                    <Setter Property="Background" Value="{StaticResource DotGridBrush}"/>
                                                    <Style.Triggers>
                                                        <!-- 世界地图画面：画布背景透明让地图透出；控件仍渲染（鼠标穿透由 Canvas IsHitTestVisible 反相控制） -->
                                                        <DataTrigger Binding="{Binding DataContext.IsWorldMapActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Canvas.Style>
                                            <!-- 框选矩形 -->
                                            <Rectangle x:Name="MarqueeRect" Stroke="{StaticResource SelectionBlueBrush}" StrokeThickness="2" Fill="#300000FF"
                                                       Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="1001"/>
                                            <!-- 两点式绘制预览（Line/Circle/Ellipse/Rectangle） -->
                                            <Path x:Name="DrawPreviewShape" Stroke="#1E90FF" StrokeThickness="1.5" Fill="#301E90FF"
                                                  Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="1002"/>
                                            <!-- 阵列辅助线预览（虚线示意落位，不移动控件） -->
                                            <Path x:Name="ArrayGuideShape" Stroke="#FF7F00" StrokeThickness="2" Fill="#20FF7F00"
                                                  StrokeDashArray="5,3" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="1003"/>
                                            <!-- 阵列落点标记：蓝色空心方块 + 序号数字（自绘覆盖层） -->
                                            <ctrl:ArrayGuideOverlay x:Name="ArrayGuideOverlay"
                                                  Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="1004"/>
                                        </Canvas>
                                        </Grid>
                                    </ScrollViewer>
                                    <!-- 缩放比例 -->
                                    <TextBlock x:Name="ZoomLabel" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               Foreground="Gray" FontSize="12" Margin="0,0,8,4" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                                <!-- 变量管理器内容（画布 Tab 激活时显示，与画布同一位置切换）
                                     注意：Visibility 必须从 Window.DataContext（EditWindowViewModel）取，
                                     不能在本 Grid 的 DataContext（VariableManagerVM）上解析——该 VM 无此属性，
                                     绑定失败会退回默认 Visible 导致常驻遮挡画布（wpf-event-routing §7 DataContext 覆盖陷阱） -->
                                <Grid Grid.Row="1" Margin="3" DataContext="{Binding VariableManagerVM, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Visibility="{Binding DataContext.VariableManagerActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="＋ 新建变量" Command="{Binding NewTagCommand}" Width="90" Height="26" Margin="0,0,4,0" ToolTip="新建变量"/>
                                        <Button Content="✏ 编辑" Command="{Binding EditTagCommand}" Width="60" Height="26" Margin="0,0,4,0" ToolTip="编辑选中变量（或双击行）"/>
                                        <Button Content="🗑 删除" Width="60" Height="26" Click="TagDelete_Click" ToolTip="删除选中变量（被引用时拒绝；多选可批量）"/>
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Left" Text="搜索:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="12" VerticalContentAlignment="Center"/>
                                    </DockPanel>
                                    <Grid Grid.Row="2">
                                        <DataGrid x:Name="TagGrid" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                                                  HeadersVisibility="Column" IsReadOnly="True" MouseDoubleClick="TagGrid_DoubleClick"
                                                  PreviewMouseLeftButtonDown="TagGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="TagGrid_PreviewMouseMove" PreviewMouseLeftButtonUp="TagGrid_PreviewMouseLeftButtonUp" PreviewKeyDown="TagGrid_KeyDown"
                                                  SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="Horizontal" BorderBrush="LightGray" FontSize="12"
                                                  RowHeight="26" EnableRowVirtualization="True"
                                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                                  ScrollViewer.CanContentScroll="True"
                                                  SizeChanged="TagGrid_SizeChanged">
                                            <DataGrid.RowStyle>
                                                <!-- 强制选中样式：不依赖 DataGrid 激活状态（未激活时默认用 InactiveSelectionHighlightBrush 浅灰≈背景，
                                                     用户反馈框选后高亮不可见；显式固定蓝色选中，激活/未激活一致） -->
                                                <Style TargetType="DataGridRow">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource SelectionBlueBrush}"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.RowStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTextColumn Header="类型" Binding="{Binding DataType}" Width="55"/>
                                                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="*"/>
                                                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="42"/>
                                                <DataGridTextColumn Header="周期" Binding="{Binding ScanIntervalMs}" Width="48"/>
                                                <DataGridTextColumn Header="基准值" Binding="{Binding BaseValue}" Width="*" MinWidth="120"/>
                                            </DataGrid.Columns>
                                            <DataGrid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="＋ 新建变量" Command="{Binding NewTagCommand}"/>
                                                    <MenuItem Header="✏ 编辑变量" Command="{Binding EditTagCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Header="🗑 删除选中项" Click="TagDelete_Click"/>
                                                </ContextMenu>
                                            </DataGrid.ContextMenu>
                                        </DataGrid>
                                        <!-- 框选覆盖层（变量多选：空白处拖动框选；外包 Canvas 保证 SetLeft/Top 权威定位，颜色与画布框选一致） -->
                                        <Canvas IsHitTestVisible="False" Panel.ZIndex="10">
                                            <Rectangle x:Name="TagGridMarquee" Stroke="{StaticResource SelectionBlueBrush}" StrokeThickness="2" Fill="#300000FF"
                                                       Visibility="Collapsed" IsHitTestVisible="False"/>
                                        </Canvas>
                                    </Grid>
                                </Grid>
                                <!-- 通讯配置内容（Tab 激活时显示，与画布同一位置切换；Visibility 从 Window.DataContext 取防 DataContext 覆盖） -->
                                <Grid Grid.Row="1" Margin="3" DataContext="{Binding CommDeviceVM, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Visibility="{Binding DataContext.CommunicationActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="＋ 新建设备" Command="{Binding NewDeviceCommand}" Width="90" Height="26" Margin="0,0,4,0" ToolTip="新建设备通信配置"/>
                                        <Button Content="✏ 编辑" Command="{Binding EditDeviceCommand}" Width="60" Height="26" Margin="0,0,4,0" ToolTip="编辑选中设备（或双击行）"/>
                                        <Button Content="🗑 删除" Width="60" Height="26" Click="DeviceDelete_Click" ToolTip="删除选中设备（多选可批量）"/>
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Left" Text="搜索:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="12" VerticalContentAlignment="Center"/>
                                    </DockPanel>
                                    <DataGrid x:Name="DeviceGrid" Grid.Row="2" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                                              HeadersVisibility="Column" IsReadOnly="True" MouseDoubleClick="DeviceGrid_DoubleClick" PreviewKeyDown="DeviceGrid_KeyDown"
                                              SelectionMode="Extended" GridLinesVisibility="Horizontal" BorderBrush="LightGray" FontSize="12"
                                              RowHeight="26">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="90"/>
                                            <DataGridTextColumn Header="连接参数" Binding="{Binding ConnectionInfo}" Width="*"/>
                                        </DataGrid.Columns>
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="＋ 新建设备" Command="{Binding NewDeviceCommand}"/>
                                                <MenuItem Header="✏ 编辑设备" Command="{Binding EditDeviceCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="🗑 删除选中项" Click="DeviceDelete_Click"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                    </DataGrid>
                                </Grid>
                                <!-- 报警配置内容（Tab 激活时显示，与画布同一位置切换；Visibility 从 Window.DataContext 取防 DataContext 覆盖） -->
                                <Grid Grid.Row="1" Margin="3" DataContext="{Binding AlarmVM, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Visibility="{Binding DataContext.AlarmActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="＋ 新建报警" Command="{Binding NewAlarmCommand}" Width="90" Height="26" Margin="0,0,4,0" ToolTip="新建报警规则"/>
                                        <Button Content="✏ 编辑" Command="{Binding EditAlarmCommand}" Width="60" Height="26" Margin="0,0,4,0" ToolTip="编辑选中报警（或双击行）"/>
                                        <Button Content="🗑 删除" Width="60" Height="26" Click="AlarmDelete_Click" ToolTip="删除选中报警（多选可批量）"/>
                                    </StackPanel>
                                    <DockPanel Grid.Row="1" Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Left" Text="搜索:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="12"/>
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="12" VerticalContentAlignment="Center"/>
                                    </DockPanel>
                                    <DataGrid x:Name="AlarmGrid" Grid.Row="2" ItemsSource="{Binding Alarms}" SelectedItem="{Binding SelectedAlarm}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                                              HeadersVisibility="Column" IsReadOnly="True" MouseDoubleClick="AlarmGrid_DoubleClick" PreviewKeyDown="AlarmGrid_KeyDown"
                                              SelectionMode="Extended" GridLinesVisibility="Horizontal" BorderBrush="LightGray" FontSize="12"
                                              RowHeight="26">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="变量" Binding="{Binding TagName}" Width="*"/>
                                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90"/>
                                            <DataGridTextColumn Header="阈值" Binding="{Binding Threshold, StringFormat={}{0:0.###}}" Width="70"/>
                                            <DataGridTextColumn Header="等级" Binding="{Binding Level}" Width="80"/>
                                        </DataGrid.Columns>
                                        <DataGrid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="＋ 新建报警" Command="{Binding NewAlarmCommand}"/>
                                                <MenuItem Header="✏ 编辑报警" Command="{Binding EditAlarmCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="🗑 删除选中项" Click="AlarmDelete_Click"/>
                                            </ContextMenu>
                                        </DataGrid.ContextMenu>
                                    </DataGrid>
                                </Grid>
                                <!-- W3 用户面板内容（用户 Tab 激活时显示，与画布同一位置切换；三子页：用户名设置/用户组策略/用户安全设置） -->
                                <Grid Grid.Row="1" Margin="3"
                                      Visibility="{Binding DataContext.UserActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <TabControl x:Name="UserPanelTabs" SelectedIndex="{Binding DataContext.UserPanelPage, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <!-- 页 0：用户名设置（用户 CRUD） -->
                                        <TabItem Header="用户名设置">
                                            <Grid Margin="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Button Content="＋ 添加用户" Width="110" Height="26" Click="UserAdd_Click" ToolTip="弹窗填写用户名/密码/所属组（P2-12：与变量管理器统一弹窗）"/>
                                                    <Button Content="🗑 删除选中用户" Width="110" Height="26" Margin="8,0,0,0" Click="UserDelete_Click" ToolTip="删除选中用户（不能删除最后一个管理员）"/>
                                                </StackPanel>
                                                <DataGrid Grid.Row="1" x:Name="UsersGrid" ItemsSource="{Binding DataContext.UserAccounts, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DataContext.SelectedUser, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal" BorderBrush="LightGray" FontSize="12" RowHeight="26"
                                                          MouseDoubleClick="UsersGrid_MouseDoubleClick" PreviewKeyDown="UsersGrid_PreviewKeyDown" PreviewMouseRightButtonDown="UsersGrid_PreviewMouseRightButtonDown">
                                                    <DataGrid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="复制" Click="UserCopy_Click"/>
                                                            <MenuItem Header="粘贴" Click="UserPaste_Click"/>
                                                            <Separator/>
                                                            <MenuItem Header="删除" Click="UserDelete_Click"/>
                                                        </ContextMenu>
                                                    </DataGrid.ContextMenu>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="*"/>
                                                        <DataGridTextColumn Header="所属组" Binding="{Binding GroupName}" Width="*"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </TabItem>
                                        <!-- 页 1：用户组策略（组权限） -->
                                        <TabItem Header="用户组策略">
                                            <Grid Margin="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="预置组：管理员（全权）/ 操作员（报警确认·画面编辑）/ 访客（默认全禁）——不可删除可复制。双击组行编辑；右键复制/粘贴/删除。" FontSize="11" Foreground="Gray" Margin="0,0,0,4" TextWrapping="Wrap" IsHitTestVisible="False"/>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Button Content="＋ 新建组" Width="90" Height="26" Click="GroupAdd_Click"/>
                                                    <Button Content="删除选中组" Width="96" Height="26" Margin="8,0,0,0" Click="GroupDelete_Click"/>
                                                </StackPanel>
                                                <DataGrid x:Name="GroupsGrid" Grid.Row="2" ItemsSource="{Binding DataContext.UserGroups, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                                          GridLinesVisibility="Horizontal" BorderBrush="LightGray" FontSize="12" RowHeight="26"
                                                          MouseDoubleClick="GroupsGrid_MouseDoubleClick" PreviewKeyDown="GroupsGrid_PreviewKeyDown" PreviewMouseRightButtonDown="GroupsGrid_PreviewMouseRightButtonDown">
                                                    <DataGrid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="复制" Click="GroupCopy_Click"/>
                                                            <MenuItem Header="粘贴" Click="GroupPaste_Click"/>
                                                            <Separator/>
                                                            <MenuItem Header="删除" Click="GroupDelete_Click"/>
                                                        </ContextMenu>
                                                    </DataGrid.ContextMenu>
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="组名" Binding="{Binding Name}" Width="140"/>
                                                        <DataGridTemplateColumn Header="权限">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding PermissionDisplay}" TextTrimming="CharacterEllipsis"/>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </TabItem>
                                        <!-- 页 2：用户安全设置（密码策略） -->
                                        <TabItem Header="用户安全设置">
                                            <StackPanel Margin="4" MaxWidth="420" HorizontalAlignment="Left">
                                                <TextBlock Text="密码策略（FW 登录时强制）" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="最小密码长度:" VerticalAlignment="Center" Margin="0,3"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DataContext.Security.MinPasswordLength, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" Margin="0,3"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="要求包含数字:" VerticalAlignment="Center" Margin="0,3"/>
                                                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding DataContext.Security.RequireDigit, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="0,3"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="要求包含字母:" VerticalAlignment="Center" Margin="0,3"/>
                                                    <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding DataContext.Security.RequireLetter, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="0,3"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="要求大小写混合:" VerticalAlignment="Center" Margin="0,3"/>
                                                    <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding DataContext.Security.RequireUpperLower, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="0,3"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="要求特殊字符:" VerticalAlignment="Center" Margin="0,3"/>
                                                    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding DataContext.Security.RequireSpecial, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="0,3"/>
                                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="密码有效期(天,0=不过期):" VerticalAlignment="Center" Margin="0,3"/>
                                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DataContext.Security.PasswordMaxAgeDays, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" Margin="0,3"/>
                                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="连续失败锁定阈值(0=不锁):" VerticalAlignment="Center" Margin="0,3"/>
                                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding DataContext.Security.FailedLoginLockout, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" Margin="0,3"/>
                                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="锁定时长(分钟):" VerticalAlignment="Center" Margin="0,3"/>
                                                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding DataContext.Security.LockMinutes, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PropNumberBox}" Margin="0,3"/>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <Button Content="✔ 保存安全设置" Width="120" Height="28" Click="UserSaveSecurity_Click" ToolTip="保存密码策略到工程"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                                <!-- 列表管理内容（Tab 激活时显示，与画布同一位置切换；Visibility 从 Window.DataContext 取防 DataContext 覆盖） -->
                                <Grid Grid.Row="1" Margin="3" DataContext="{Binding ListManagerVM, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Visibility="{Binding DataContext.ListManagerActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                    <TabControl x:Name="ListManagerTabs" SelectedIndex="{Binding DataContext.ListManagerSelectedIndex, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <!-- 文本列表页 -->
                                        <TabItem Header="文本列表">
                                            <Grid Margin="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBox Text="{Binding NewTextListName, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="26" VerticalContentAlignment="Center" FontSize="12" ToolTip="新列表名称"/>
                                                    <Button Content="＋ 新建列表" Command="{Binding NewTextListCommand}" Width="90" Height="26" Margin="4,0,0,0" ToolTip="创建文本列表（预设值可在右侧编辑）"/>
                                                    <Button Content="🗑 删除列表" Width="90" Height="26" Margin="4,0,0,0" Click="TextListDelete_Click" ToolTip="删除选中列表（被控件引用时拒绝；多选可批量）"/>
                                                </StackPanel>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ListBox x:Name="TextListBox" Grid.Column="0" Margin="0,0,4,0" ItemsSource="{Binding TextLists}" SelectedItem="{Binding SelectedTextList}" DisplayMemberPath="Name" FontSize="12" SelectionMode="Extended" PreviewKeyDown="TextListBox_KeyDown"/>
                                                    <Grid Grid.Column="1">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Text="列表名:" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding TextListName, UpdateSourceTrigger=LostFocus}" FontSize="12" VerticalContentAlignment="Center" KeyDown="PropField_KeyDown" ToolTip="重命名列表（失焦或回车提交，级联同步控件引用）"/>
                                                        </DockPanel>
                                                        <DataGrid x:Name="TextItemsGrid" Grid.Row="1" ItemsSource="{Binding TextItems}" SelectedItem="{Binding SelectedTextItem}" PreviewKeyDown="TextItemsGrid_KeyDown"
                                                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                                                  HeadersVisibility="Column" SelectionMode="Extended" GridLinesVisibility="Horizontal" BorderBrush="LightGray" FontSize="12"
                                                                  RowHeight="26">
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="序号" Binding="{Binding Number}" Width="50" IsReadOnly="True"/>
                                                                <DataGridTextColumn Header="值" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Button Content="＋ 添加项" Command="{Binding AddTextItemCommand}" Width="80" Height="26" Margin="0,0,4,0"/>
                                                            <Button Content="－ 删除项" Width="80" Height="26" Click="TextItemsDelete_Click" ToolTip="删除选中项（多选可批量）"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </TabItem>
                                        <!-- 图片列表页 -->
                                        <TabItem Header="图片列表">
                                            <Grid Margin="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBox Text="{Binding NewImageListName, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="26" VerticalContentAlignment="Center" FontSize="12" ToolTip="新列表名称"/>
                                                    <Button Content="＋ 新建列表" Command="{Binding NewImageListCommand}" Width="90" Height="26" Margin="4,0,0,0" ToolTip="创建图片列表（图片路径按回车确认，不存在标红）"/>
                                                    <Button Content="🗑 删除列表" Width="90" Height="26" Margin="4,0,0,0" Click="ImageListDelete_Click" ToolTip="删除选中列表（被控件引用时拒绝；多选可批量）"/>
                                                </StackPanel>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ListBox x:Name="ImageListBox" Grid.Column="0" Margin="0,0,4,0" ItemsSource="{Binding ImageLists}" SelectedItem="{Binding SelectedImageList}" DisplayMemberPath="Name" FontSize="12" SelectionMode="Extended" PreviewKeyDown="ImageListBox_KeyDown"/>
                                                    <Grid Grid.Column="1">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                                            <TextBlock DockPanel.Dock="Left" Text="列表名:" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0"/>
                                                            <TextBox Text="{Binding ImageListName, UpdateSourceTrigger=LostFocus}" FontSize="12" VerticalContentAlignment="Center" KeyDown="PropField_KeyDown" ToolTip="重命名列表（失焦或回车提交，级联同步控件引用）"/>
                                                        </DockPanel>
                                                        <DataGrid x:Name="ImageItemsGrid" Grid.Row="1" ItemsSource="{Binding ImageItems}" SelectedItem="{Binding SelectedImageItem}" PreviewKeyDown="ImageItemsGrid_KeyDown"
                                                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                                                                  HeadersVisibility="Column" SelectionMode="Extended" GridLinesVisibility="Horizontal" BorderBrush="LightGray" FontSize="12"
                                                                  RowHeight="38">
                                                            <DataGrid.RowStyle>
                                                                <Style TargetType="DataGridRow">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding PathValid}" Value="False">
                                                                            <Setter Property="Background" Value="#FFE0E0"/>
                                                                            <Setter Property="ToolTip" Value="图片文件不存在（相对工程目录）"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </DataGrid.RowStyle>
                                                            <DataGrid.Columns>
                                                                <DataGridTextColumn Header="序号" Binding="{Binding Number}" Width="40" IsReadOnly="True"/>
                                                                <DataGridTemplateColumn Header="预览" Width="64">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <Border BorderBrush="LightGray" BorderThickness="1" Background="#F5F5F5" Width="52" Height="32" Margin="2,0"
                                                                                    VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="2">
                                                                                <Grid>
                                                                                    <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImageConverter}}" Stretch="Uniform" Margin="2"/>
                                                                                    <TextBlock Text="无图" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                                        <TextBlock.Style><Style TargetType="TextBlock">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                            <Style.Triggers><DataTrigger Binding="{Binding PreviewImagePath}" Value="{x:Null}">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                            </DataTrigger></Style.Triggers>
                                                                                        </Style></TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTemplateColumn Header="图片路径" Width="*">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Value}" VerticalAlignment="Center" Margin="4,0" ToolTip="图片路径（相对工程目录，回车确认）"/>
                                                                                <!-- 路径选择器：点选图片文件 → 转相对路径存值 -->
                                                                                <Button Content="📁" Width="26" Height="22" Margin="4,0,0,0" Click="ImageListBrowse_Click" Focusable="False" ToolTip="选择图片文件"/>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                                        <DataTemplate>
                                                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" KeyDown="ImagePathBox_KeyDown" ToolTip="相对工程目录的图片路径，回车确认；支持 &quot;path&quot; / 'path' 引号"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                                </DataGridTemplateColumn>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Button Content="＋ 添加项" Command="{Binding AddImageItemCommand}" Width="80" Height="26" Margin="0,0,4,0"/>
                                                            <Button Content="－ 删除项" Width="80" Height="26" Click="ImageItemsDelete_Click" ToolTip="删除选中项（多选可批量）"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Grid></avalon:LayoutDocument>
                        </avalon:LayoutDocumentPane>

                        <!-- 右侧: 属性窗口 -->
                        <avalon:LayoutAnchorablePane DockWidth="260">
                            <avalon:LayoutAnchorable Title="属性" ContentId="property">
                                <Grid Margin="4" DataContext="{Binding PropertyVM, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock Text="请选择一个控件" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" FontSize="14">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsPropertyVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                                  Visibility="{Binding IsPropertyVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding WidgetTypeName, StringFormat='属性 - {0}'}" FontWeight="Bold" FontSize="13" Margin="4,2"/>
                                            <Separator Margin="4,2"/>
                                            <ContentControl Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{x:Null}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="Screen"><Setter Property="ContentTemplate" Value="{StaticResource PropScreen}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="ButtonWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropButton}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="MultiSelect"><Setter Property="ContentTemplate" Value="{StaticResource PropMultiSelect}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="TextWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropText}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="RectangleWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropRect}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="LabelWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropLabelWidget}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="ImageWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropImage}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="NumericDisplayWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropNumericDisplay}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="SwitchWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropSwitch}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="LineWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropLine}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="CircleWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropCircle}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="EllipseWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropEllipse}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="IOFieldWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropIOField}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="CheckBoxWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropCheckBox}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="TextListWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropTextListWidget}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="FrameWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropFrame}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="ProgressBarWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropProgressBar}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="DateTimeWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropDateTime}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedObjectType}" Value="WindowWidget"><Setter Property="ContentTemplate" Value="{StaticResource PropWindow}"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style></ContentControl.Style></ContentControl>
                                            <!-- 事件栏（DESIGN-EVENTS.md §4：选中控件且支持事件时显示可用事件 + 配置入口） -->
                                            <StackPanel Visibility="{Binding EventBarVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Separator Margin="4,2"/>
                                                <TextBlock Text="事件" FontWeight="Bold" FontSize="13" Margin="4,2"/>
                                                <TextBlock Text="（图形类/标签不支持事件）" FontSize="10" Foreground="Gray" Margin="4,0,4,2"/>
                                                <ItemsControl ItemsSource="{Binding EventRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="4,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="Gray"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="配置…" FontSize="11" Padding="8,2"
                                                                        VerticalAlignment="Center" Click="OpenEventConfig_Click" Tag="{Binding Type}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </avalon:LayoutAnchorable>
                        </avalon:LayoutAnchorablePane>
                    </avalon:LayoutPanel>

                    <!-- 底部: CLI -->
                    <avalon:LayoutAnchorablePane DockHeight="180">
                        <avalon:LayoutAnchorable Title="CLI 控制台" ContentId="cli">
                            <!-- Background=Transparent：空白区可命中测试，点击任意处才能聚焦输入框（wpf-event-routing §1） -->
                            <Grid PreviewMouseDown="CliPanel_PreviewMouseDown" Background="Transparent">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                                <ScrollViewer Grid.Row="0" x:Name="CliOutputScroller" VerticalScrollBarVisibility="Auto">
                                    <TextBox x:Name="CliOutput" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                             Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0" TextWrapping="Wrap"/>
                                </ScrollViewer>
                                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="LightGray"/>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text=">" FontFamily="Consolas" FontSize="13" Foreground="LimeGreen" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="CliInput" FontFamily="Consolas" FontSize="13"
                                             Background="#1E1E1E" Foreground="White" BorderThickness="0"
                                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="120"
                                             PreviewKeyDown="CliInput_KeyDown"/>
                                </Grid>
                            </Grid>
                        </avalon:LayoutAnchorable>
                                            </avalon:LayoutAnchorablePane>
                </avalon:LayoutPanel>
            </avalon:LayoutRoot>
        </avalon:DockingManager>

        <!-- ═══ AI 助手：悬浮按钮（任务11 退回内嵌）+ 右侧侧边栏 ═══ -->
        <Button x:Name="AiFabBtn" Grid.Row="3" Panel.ZIndex="1000" Width="46" Height="46" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,26" ToolTip="AI 助手（拖动可移动位置）"
                Background="#2D2D30" Foreground="White" BorderThickness="0" Cursor="Hand"
                PreviewMouseLeftButtonDown="AiFab_MouseDown" PreviewMouseMove="AiFab_MouseMove" PreviewMouseLeftButtonUp="AiFab_MouseUp">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="23" Background="{TemplateBinding Background}" BorderBrush="#555" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3E3E42"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <TextBlock Text="AI" FontWeight="Bold" FontSize="16"/>
        </Button>

        <Grid Grid.RowSpan="99" Width="380" HorizontalAlignment="Right" Margin="0,0,0,0"
              Visibility="{Binding IsAiPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#FAFAFA" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- 顶栏：标题 + 新建会话 + 关闭 -->
                    <Grid Grid.Row="0" Background="#2D2D30">
                        <TextBlock Text="AI 助手" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,4,4">
                            <Button Content="＋ 新会话" Height="26" Padding="8,0" Margin="0,0,4,0"
                                    Background="#3E3E42" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding AiNewSessionCommand}" ToolTip="清空历史，开始新会话"/>
                            <Button Content="✕" Width="28" Height="26" Margin="0,0,4,0"
                                    Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding ToggleAiPanelCommand}"/>
                        </StackPanel>
                    </Grid>
                    <!-- 对话列表（气泡风格；消息为只读 TextBox：可拖选复制，未选中右键复制整条） -->
                    <ListBox x:Name="AiMessagesList" Grid.Row="1" ItemsSource="{Binding AiMessages}" Background="White" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10,6">
                                    <TextBlock FontWeight="Bold" FontSize="11" Foreground="#888888" Margin="0,0,0,2">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="系统"/>
                                                <Setter Property="Foreground" Value="#E67E22"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="user"><Setter Property="Text" Value="你"/><Setter Property="Foreground" Value="#2D7DD2"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="ai"><Setter Property="Text" Value="AI"/><Setter Property="Foreground" Value="#7B1FA2"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border CornerRadius="6" Padding="8,5" MaxWidth="330" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                                        <Setter Property="Background" Value="#D6E8FB"/>
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="status">
                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBox Text="{Binding Content}" Tag="{Binding Content}"
                                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 TextWrapping="Wrap" FontSize="13" MinWidth="40"
                                                 Foreground="#222222" Padding="2,2" VerticalContentAlignment="Center"
                                                 VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                                 IsInactiveSelectionHighlightEnabled="True" SelectionBrush="#7FB2E5"
                                                 ContextMenu="{StaticResource AiMessageContextMenu}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Foreground" Value="#222222"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="status">
                                                            <Setter Property="Foreground" Value="#E67E22"/>
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 输入区 -->
                    <Grid Grid.Row="2" Margin="10,8,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AiInputBox" Grid.Column="0" Text="{Binding AiInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto"
                                 FontSize="13" MinHeight="28" VerticalAlignment="Bottom" IsEnabled="{Binding IsAiThinking, Converter={StaticResource InverseBoolConverter}}"
                                 KeyDown="AiInput_KeyDown" PreviewKeyDown="AiInput_PreviewKeyDown" ToolTip="输入自然语言指令；Enter 发送，Shift+Enter 换行"/>
                        <Button Grid.Column="1" Width="56" Margin="6,0,0,0" VerticalAlignment="Bottom"
                                Command="{Binding AiSendOrCancelCommand}" Foreground="White" BorderThickness="0"
                                Padding="0,6" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="发送"/>
                                    <Setter Property="Background" Value="#2D7DD2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAiThinking}" Value="True">
                                            <Setter Property="Content" Value="停止"/>
                                            <Setter Property="Background" Value="#C0392B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <!-- 会话设置（发送栏下方；API Key 已移至「设置 → AI 助手设置…」窗口，密文存储） -->
                    <Border Grid.Row="3" Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模型" VerticalAlignment="Center" Foreground="#555555" FontSize="12"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AiModels}" SelectedItem="{Binding SelectedAiModel}"
                                          DisplayMemberPath="Label" Height="26" FontSize="12"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="74"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="74"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="推理深度" VerticalAlignment="Center" Foreground="#555555" FontSize="12"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AiDepths}" SelectedItem="{Binding SelectedAiDepth}"
                                          DisplayMemberPath="Label" Height="26" FontSize="12" ToolTip="单次指令最大模型调用轮次：快速 2 / 均衡 4 / 深度 8"/>
                                <TextBlock Grid.Column="2" Text="" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="上下文" VerticalAlignment="Center" Foreground="#555555" FontSize="12"/>
                                <ComboBox Grid.Column="4" ItemsSource="{Binding AiContexts}" SelectedItem="{Binding SelectedAiContext}"
                                          DisplayMemberPath="Label" Height="26" FontSize="12" ToolTip="会话历史保留轮数：短 4 / 中 10 / 长 20"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
